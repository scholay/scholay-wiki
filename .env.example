# ============================================================================
# Scholay 环境变量 — 模板(`cp .env.example .env` 后改值)
#
# 作用范围:docker-compose.yml 用 `${VAR}` / `${VAR:-默认值}` 引用本文件的变量,注入各容器。
#          **compose 没有 env_file**,只有被 `${VAR}` 引用到的变量才生效。
#
# 本地 docker-compose.yml 与线上 docker-compose.prod.yml 对齐(同名变量喂同样的容器)。
# 主区只放:密钥/凭据、常用开关;「值 = compose 默认」的旋钮收进文末「可选覆盖」段。
# 标 `CHANGE_ME` 的值**必须改**(生产严禁原样部署)。修改后 `docker-compose up -d` 生效。
# ============================================================================


# ━━━━━━━━━━━━━━━━━━━━ 1. 站点基础 ━━━━━━━━━━━━━━━━━━━━

# ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
# ┃ 这台机器扮演什么角色。**部署前第一个要想清楚的东西。**                  ┃
# ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
#   prod —— 权威生产站(可被搜索引擎索引)
#   test —— 测试 / 预发 / 克隆环境(默认不可索引)
#
# 为什么需要它:区分两套环境要拨的开关不止一个,逐个记迟早漏一个,而漏掉的那个
# 往往最贵 —— 比如测试站被搜索引擎收录成生产站的镜像,几周后排名塌了才发现。
# APP_ENV 把「这是哪套环境」收敛成**一次决策**,其余开关从它派生默认值:
#
#   开关                派生规则                      想偏离时显式写该变量即可
#   SEO_INDEXABLE       prod=true / test=false        SEO_INDEXABLE=...
#
# ⚠️ 派生的是**默认值**,显式设置的 env 永远优先。
# ⚠️ scripts/deploy.sh 强制要求这一行存在,并在生产上部署前要你确认一次
#    (最常见的误操作不是敲错命令,是敲对了命令但在错的机器上)。
# ⚠️ 后端未设置时按 prod 处理(向后兼容:本变量 2026-08-13 才引入,老 .env 没有它)。
APP_ENV=prod

# 整站唯一对外端口(用户端 + /admin 同走这个)。默认 5411
HTTP_PORT=5411
# nginx 对外端口的绑定地址。默认仅本机可访问(前面挂 Caddy 之类做 TLS 终止时的正确姿势);
# 需要真机/局域网调试、或该机器没有前置代理时才设 0.0.0.0。
# ⚠️ 两份 compose **现在都**引用它(prod 此前写死 127.0.0.1,导致在这里设了不生效 ——
#    症状是「容器全 healthy 但外网 100% 打不开」,排查方向极易被带去 nginx/防火墙)。
# ⚠️ 设 0.0.0.0 前先确认前置代理:nginx.conf 的 $fwd_proto map 依赖上游传
#    X-Forwarded-Proto(缺了会生成 http:// 分享链触发混合内容拦截),real_ip 也只信任
#    172.16/12 与回环(裸奔会让按 IP 的限流退化)。
HTTP_BIND_ADDRESS=127.0.0.1

# 本环境的主域 —— canonical / sitemap <loc> / og:url / JSON-LD / 邮件里的绝对链接
# / 邀请分享链 / SEO 推送 origin 全部由它派生(backend 24 处消费点 + 前端 index.html)。
#
# 🔴 代码里**没有任何真实域名的默认值**了(2026-08-13 起)。以前 config.go 和两份 compose
#    都以生产域名兜底,后果是「漏配」与「配对了」在启动时完全同形 —— 一个漏配的环境会
#    静默宣称自己是生产站,而这类错误不报错、不留日志,只在搜索引擎那头显形。
#    现在:release 模式漏配 = **启动失败**;debug 模式回落 localhost。
# 必须与实际对外访问的 host 逐字一致(带不带 www 都行,但要和 nginx/CDN 的 301 方向一致)。
SITE_URL=https://www.scholay.com

# 站点品牌名。仅用于 umami 自动建站点的显示名;品牌文案本身在代码里(两套环境是同一个产品)。
SITE_NAME=Scholay

# 客服 / 联系邮箱(前后端 fan-out)。
# 🔴 默认留空,不再兜底成某个真实邮箱 —— 这个值会 ① 经 /config/system 下发给前端当客服
#    邮箱,② 拼进 Unpaywall / Crossref 的礼貌池请求。那两家**按 email 维度限速**,
#    多套环境共用一个地址 = 任何一套跑批量测试都会连累其它所有环境,而且归因不到。
#    留空的后果只是前端不展示邮箱入口 + 后端跳过 Unpaywall 查询,可接受。
SUPPORT_EMAIL=support@scholay.com

# 本环境是否允许被搜索引擎索引。**正常情况留空,由 APP_ENV 派生。**
#
# 不可索引时的完整效果:
#      · /robots.txt 只输出 `Disallow: /`,且**不输出 Sitemap 指令**
#      · /sitemap*.xml 与 IndexNow key 文件返回 404
#      · 所有 SSR 响应带 `X-Robots-Tag: noindex, nofollow` 并注入 <meta name="robots">
#    三者必须一起生效:robots.txt 只劝阻抓取,已被外链或证书透明日志(CT)发现的 URL
#    仍要靠 noindex 才不进索引。
# 留空 = 从 APP_ENV 派生(prod → true,test/dev → false),这是推荐做法 ——
# 单独看这一个开关时,默认 true 会让新环境忘配就被收录、默认 false 会让老生产升级后
# 静默掉出索引,两头都不好;挂到 APP_ENV 上则两边同时正确。
# 只在需要偏离该默认时才显式填(例如 APP_ENV=test 但确实想让某个公开演示站被收录)。
# 启动日志每次都会回显当前生效值。
SEO_INDEXABLE=

# 浏览器标签页标题前缀,如 "[TEST] "。生产留空。
# 多套环境并行时用它一眼分清「我现在在哪套」—— 品牌名本身不参数化(两边是同一个产品)。
SITE_TITLE_PREFIX=

# Microsoft Clarity 项目 ID(会话录制 / 热图 / 点击流)。留空 = 整段 tracker 不加载。
# 🔴 每套环境必须用**各自的**项目。以前这个 id 写死在 index.html 里,意味着任何环境的
#    测试点击、造数、压测录像都以同一个项目的名义上报,而 Clarity 只能按 URL 过滤,
#    污染无法事后剔除;部署方在容器里也没有任何办法关掉它。
CLARITY_PROJECT_ID=

# ICP 备案号(中国大陆运营要求),显示在页脚。留空则整块不渲染。
# 🔴 备案号与【已备案的域名】绑定,不是与代码绑定。未接入备案的域名公开展示它属于错挂,
#    被举报或巡检时处理对象是**那条备案本身**,可能连累已备案站点被要求整改。
#    非权威环境请留空(或先把该域名接入备案)。
ICP_BEIAN=

# CORS 允许来源。默认 *(开发友好,禁用 cookie 凭据)。生产改逗号分隔白名单。
CORS_ALLOWED_ORIGINS=*


# ━━━━━━━━━━━━━━━━━━━━ 2. 安全 / 密钥 ━━━━━━━━━━━━━━━━━━━━

# JWT 签名密钥。**必须换 ≥32 字符随机串**;改了所有用户需重新登录。
JWT_SECRET=CHANGE_ME_at_least_32_chars_random

# 超级管理员初始账号:首次启动 schema-sync 时自动播种。改密在 admin 后台做。
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=CHANGE_ME_admin_initial_pwd


# ━━━━━━━━━━━━━━━━━━━━ 3. MySQL 数据库 ━━━━━━━━━━━━━━━━━━━━
# 仅容器内部访问。ROOT_PASSWORD 还给 schema-sync 用(root 权限自动建 umami 库 + GRANT)。
MYSQL_ROOT_PASSWORD=CHANGE_ME_mysql_root_pwd
MYSQL_DATABASE=scholar
MYSQL_USER=scholar_user
MYSQL_PASSWORD=CHANGE_ME_db_user_pwd


# ━━━━━━━━━━━━ 3.5 correctness 键专用 Redis(redis-persist)━━━━━━━━━━━━
#
# 🔴 这四行**必须显式写着,不要注释掉**(2026-08-02 计费审计 P0-1)。
#
# 周期额度 anchor/used、JWT 吊销标记、SEO 推送队列这类 correctness 键不能待在主 Redis:
# 主池是 maxmemory 512mb + allkeys-lru,内存一紧就**静默逐出**;而 quota:anchor 被逐出
# 与「窗口到期」在读路径上完全同形(vip/quota.go 的 loadWindow),结果是该用户白拿一个
# 整窗额度 —— 没有日志、没有告警。redis-persist 是 noeviction:写满返回 OOM 而不是丢键。
#
# 两份 compose 侧虽有同名默认值兜底,但**显式写在这里才不依赖那个默认** ——
# 万一有人把 compose 回滚成旧版(默认空),不至于静默失守。
# ⚠️ 首次启用是一次存储切换(在飞窗口 / 吊销标记 / 推送队列从零开始),选低峰窗口部署。
REDIS_PERSIST_HOST=redis-persist
REDIS_PERSIST_PORT=6379
REDIS_PERSIST_PASSWORD=
REDIS_PERSIST_DB=0


# ━━━━━━━━━━━━━━━━━━━━ 4. MinIO 对象存储(用户上传 PDF)━━━━━━━━━━━━━━━━━━━━
# 仅容器内部访问。ROOT_USER/PASSWORD 既是管理员凭据,也派生成 backend 的 ACCESS/SECRET_KEY。
MINIO_ROOT_USER=scholarminio
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_root_pwd
# 存论文 PDF 的 bucket 名(后端启动时自动创建)。
MINIO_BUCKET_PAPER_PDFS=scholar-paper-pdfs
# agent 输入框上传附件的 bucket(0112 耐久化;不配则用默认名,后端启动时自动创建)。
# 与 agent 产出物分桶:产出物随会话生命周期,附件是用户原始数据、**不挂任何 lifecycle**,
# 只由「用户删 / 删会话 / 删用户」三条显式路径回收。
MINIO_BUCKET_AGENT_ATTACHMENTS=scholar-agent-attachments
# 附件孤儿对象 reaper 是否真删(默认 false = 只报告不删)。
# 孤儿 = 桶里有对象、agent_attachments 里却没有任何未删的行指向它(上传时 PUT 成功但落库失败、
# 或删除时「先删行后删对象」中间崩溃)。它不计配额、无取回入口、无人可发现,永远占盘。
# 🔴 默认 dry-run:这个任务删的是用户上传的原始数据,误删不可逆且本项目至今没有备份。
# 先看几天日志(docker logs scholar_backend | grep "agentattach reaper"),核对 orphans 计数与
# sample_keys 无误,再改成 true。判据本身另有三道保险:只删 24h 前的对象、DB 反查失败整批放过、
# 软删行也不算引用。
AGENT_ATTACHMENT_REAPER_DELETE=false
# 连接 MinIO 是否用 https。生产用 TLS 时改 true。
MINIO_USE_SSL=false


# ━━━━━━━━━━━━━━━━━━━━ 5. AI Agent 容器(scholar_agent)━━━━━━━━━━━━━━━━━━━━

# 内网桥接 token:backend 调 agent /api/* 必须带它。compose fan-out 到 agent + backend。必须换随机串。
AGENT_INTERNAL_TOKEN=CHANGE_ME_agent_internal_bridge_token_32chars

# agent 预装 Minicod MCP(论文/期刊/作者检索)的 API key。本地 + 线上 compose 都取这个喂 agent。
# 注:backend 侧 minicod 不吃这个 env(走 DB third_party_accounts 池),所以只有这一个 minicod key 变量。留空 → 检索不可用。
AGENT_MINICOD_API_KEY=

# 启用的 agent feature 列表(逗号分隔)。默认 smart_search,claw,prism,peerreview,boltslides,sci_draw
# ⚠️ 这一行会**盖掉** docker-compose 里的默认值,新增 feature 必须同步加进来。
#    2026-08-06 实测:漏掉 stat_lab 时,新会话第一程正常,但 executor 侧 meta 被回收后
#    (30min 空闲 / 容器重启)继续聊同一会话 —— 历史照常显示(走 journal),模型却完全不记得
#    前面说过什么、传过什么文件,**且没有任何错误提示**;system prompt 也一起丢。
AGENT_EXECUTOR_FEATURES=smart_search,claw,prism,peerreview,boltslides,sci_draw,stat_lab

# 事件溯源脊柱:shadow=影子写账本 / on / 空关闭。
AGENT_TURN_JOURNAL=shadow
# 后台校验 journal==daemon:on / 空关闭。
# ⚠️ 只有本地 docker-compose.yml 接线,**docker-compose.prod.yml 不引用** ——
#    生产/测试环境设了不生效,是个本地专用的排查开关。
AGENT_JOURNAL_VALIDATE=on
# 注:AGENT_JOURNAL_READ 已删 —— 代码里没有任何地方读它。历史读路径默认就走 durable
#     journal;要把个别 feature 紧急回滚到 daemon 读,用 AGENT_JOURNAL_DAEMON_ONLY=<feature,...>
#     (该变量目前两份 compose 都未接线,需要时先加接线)。


# ━━━━━━━━━━━━━━━━━━━━ 6. 智能写作 Prism ━━━━━━━━━━━━━━━━━━━━
# 注:Prism 已全量上线,「即将推出」机制整体移除(commit 98b5976a9),
#     PRISM_COMING_SOON / VITE_PRISM_COMING_SOON 两个开关前后端都已无消费点,均已删除。
#     Prism 的运行期旋钮见文末「可选覆盖」段的 PRISM_COMPILE_*。


# ━━━━━━━━━━━━━━━━━━━━ 7. 统计 Umami(自托管,共用 scholar_mysql)━━━━━━━━━━━━━━━━━━━━
# APP_SECRET 给 umami 容器自签 token 用;改值需重启 umami。必须换 ≥32 字符随机串。
UMAMI_APP_SECRET=CHANGE_ME_umami_app_secret_32chars
# 可选 override:留空(推荐)→ backend 首次访问自动 bootstrap;已有别的 website 填其 UUID。
UMAMI_WEBSITE_ID=

# ── 爬虫监控(服务端旁路,internal/crawlerwatch)──
# umami 常规采集 = 页面 JS tracker + 服务端 isbot 过滤,两道机制都天生看不见爬虫。
# 填上下面的 ID 后,backend 会把 Googlebot / GPTBot / Bytespider 等已知搜索引擎与
# AI 爬虫对 SSR 页 / robots / sitemap 的命中,异步转成事件打进该 umami 网站 ——
# 在 umami 里即可看各引擎的抓取量、时段分布与被抓页面。
# 使用说明:在 umami 后台【新建一个独立网站】(如「爬虫监控」),把它的 Website ID 填这里;
# ⚠️ 千万别用现有用户统计站点的 ID,爬虫事件会污染真人 PV/UV 数据。
# 留空 = 功能整体关闭(中间件不挂载,零开销)。改值需重启 backend。
UMAMI_CRAWLER_WEBSITE_ID=
# 可选 override:爬虫事件投递的 umami 地址;留空 → 内网默认 http://umami:3000。
UMAMI_CRAWLER_BASE_URL=


# ━━━━━━━━━━━━━━━━━━━━ 8. 支付 ━━━━━━━━━━━━━━━━━━━━
# 测试支付:true → 出现「测试支付」按钮一键履约(不走真实网关)。**生产务必 false**。
# 两份 compose 现在都透传它(prod compose 此前刻意不引用,于是用 prod compose 起的
# **测试环境**也用不了它 —— 验支付只能接真实商户号,而微信支付 v3 没有沙箱 = 真实扣款,
# 且系统内没有退款链路,只能人工去网关后台退)。
# ⚠️ 还需要 GIN_MODE=debug:release 模式下 backend 有一道资损硬闸会无视这个开关
#    (见 cmd/server/main.go),所以生产是「compose 默认 false + release 硬闸」双保险。
PAYMENT_TEST_ENABLED=false


# ━━━━━━━━━━━━━━━━━━━━ 9. SEO / 搜索引擎主动推送 ━━━━━━━━━━━━━━━━━━━━
# ⚠️ SEO_SUBMIT_ENABLED 是「是否真的对外推送」的总闸,**本地务必 false**:设 true 后 worker 会真
#    POST 到 indexnow.org / 百度,推的是主域 URL,本地伺服不了 {域名}/{KEY}.txt → 被拒收。只在生产设 true。
SEO_SUBMIT_ENABLED=false
# 推送 worker 节奏:每轮秒数 / 每轮 URL 条数。
SEO_PUSH_WORKER_INTERVAL_SECONDS=300
SEO_PUSH_BATCH_SIZE=100

# IndexNow 协议(覆盖 Bing / Yandex / Naver / Seznam / Yep)。
# KEY:8-128 位 [a-zA-Z0-9-] 自己生成,需 https://{主域}/{KEY}.txt 返回 200。
INDEXNOW_ENABLED=false
INDEXNOW_KEY=

# 百度普通收录推送。TOKEN 在 百度资源平台(ziyuan.baidu.com)→普通收录→API 提交 获取。
# SITE 必须【逐字】等于该页推送示例 URL 里的 site 参数值 —— 新版控制台通常带 scheme
# (如 https://www.scholay.com),老站点是裸 host;两种形式代码都支持。
# ⚠️ 站长平台登记的站点 host 必须与全站 canonical(www)一致:登记 apex(scholay.com)
#    会导致所有 www URL 被 not_same_site 拒收(2026-08-10 线上踩过)。
# QUOTA 填控制台显示的真实每日配额(新站通常只有 10,不是 1000;超配额的尾部会自动顺延次日)。
BAIDU_PUSH_ENABLED=false
BAIDU_PUSH_TOKEN=
BAIDU_PUSH_SITE=
BAIDU_PUSH_DAILY_QUOTA=10

# Google Search Console HTML-tag 验证(<meta name="google-site-verification"> 的 content 值)。
# 非空时 SSR 在每个页面 <head> 注入验证 meta;用 DNS TXT 做域名级验证时留空即可。
GOOGLE_SITE_VERIFICATION=

# agent 执行器并发槽(同时执行的对话轮数)。默认 4;OOM 防线由 agent 的 RSS 水位闸兜底
# (默认 cgroup 内存上限 70%,超水位拒新轮回 busy;EXECUTOR_ADMIT_MAX_RSS_MB 可覆盖,0=关闭)。
# 2026-08-10 事故:旧默认 2 在部署后高峰被打满,第 3 个并发用户起每条消息瞬时「系统正忙」。
EXECUTOR_MAX_CONCURRENT_TURNS=4


# ━━━━━━━━━━━━━━━━━━━━ 10. 可选覆盖(compose 已有默认,一般无需设)━━━━━━━━━━━━━━━━━━━━
# 全部 = docker-compose.yml 里 `${VAR:-默认}` 的默认值,不设也生效。要改再取消注释。

# — 后端 Gin 模式:release / debug / test。默认 release
# GIN_MODE=release
# — Minicod API 端点。默认 https://www.minicod.com/v1
# MINICOD_API_BASE_URL=https://www.minicod.com/v1
# — 缓存 Redis 密码(host/port/db 在 compose 内写死 redis:6379/0)。默认空;生产建议设。
# REDIS_PASSWORD=
# — claw 权限审批轴:=1 切 passthrough(测试 / HITL);默认空 = auto。
# CLAW_PERMISSION_PASSTHROUGH=
# — SEO 元数据 enrich 总开关。默认 false
# SEO_ENRICH_ENABLED=false
# — SSR 冷门实体「现拉上游」的每小时全局配额。爬虫 UA 一律拒绝(不受此值影响),
#   这个数只管非爬虫流量;**0 = 不限(不是关闭)**,留空 = 默认 200。
#   两份 compose 现在都透传它(prod compose 此前漏了,导致非权威环境无法给共享的
#   minicod 配额降速)。非权威环境建议设 1。
# SEO_ONMISS_HOURLY_BUDGET=200
# — umami 管理员凭据。backend 靠登录 umami 拿 token 取统计数据,凭据此前是编译期常量,
#   于是「新装 umami 时按安全实践改掉默认口令 admin/umami」会让 /admin/analytics 四个
#   面板同时哑掉,而报错只是 401 看不出根因。留空 = 用 umami 出厂默认。
# UMAMI_ADMIN_USER=
# UMAMI_ADMIN_PASSWORD=
# — Crossref/OpenAlex 类开放 API 的礼貌池联系邮箱。留空则回落 SUPPORT_EMAIL。
#   两者都空 → 后端跳过 Unpaywall 查询(不拿别的环境的身份去打上游)。
# CROSSREF_EMAIL=
# — LaTeX 编译并发上限 / 单次超时(秒)。默认 3 / 60
# PRISM_COMPILE_MAX_PARALLEL=3
# PRISM_COMPILE_TIMEOUT=60


# ━━━━━━━━━━━━━━━━━━━━ 11. 进阶 / 内部(容器路径·服务名,改需同步 compose 挂载)━━━━━━━━━━━━━━━━━━━━
# — 后端 → agent 基址(同指 scholar_agent 容器)。拆成外部实例才需覆盖。
# AGENT_BASE_URL=http://scholar_agent:3456
# AGENT_EXECUTOR_BASE_URL=http://scholar_agent:3456
# — MinIO 内网端点(= minio 服务名)
# MINIO_ENDPOINT=minio:9000
# — 密码 Redis 的口令(host/port/db 见主区第 3.5 段,那四行不该注释在这里)。
# REDIS_PERSIST_PASSWORD=
# — Agent 各 feature 的 skill 目录(容器内只读挂载点,须与 compose volumes 一致)
# PRISM_SKILL_ADDDIR=/prism-add
# PRISM_PERSONAS_DIR=/app/prism-personas
# PRISM_WORK_DIR=/data/prism-work
# PEERREVIEW_LENSES_DIR=/app/reviewer-lenses
# PEERREVIEW_SKILLS_DIR=/app/reviewer-skills
# SMART_SEARCH_SKILL_ADDDIR=/smart-search-add
# — 一次性:从旧 fork jsonl 归档导入历史。留空=不导入(常态)。
# AGENT_ARCHIVE_FROM_FORK=
# AGENT_ARCHIVE_FROM_JSONL=/fork-data


# ━━━━━━━━━━━━━━━━━━━━ 12. 仅生产(docker-compose.prod.yml 用,本地无效)━━━━━━━━━━━━━━━━━━━━
# IMAGE_TAG=latest
# REGISTRY=your-registry.example.com
