# ============================================================================
# Scholay 环境变量 — 模板 (cp .env.example .env 后改值)
#
# 分段同 .env: [MUST] / [SHOULD] / [OPTIONAL]。
# 占位符值请改成实际值;`CHANGE_ME` 标记的必须改 (生产严禁原样部署)。
# ============================================================================


# ─── [MUST] MySQL ─────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=CHANGE_ME_strong_random_pwd
MYSQL_DATABASE=scholar
MYSQL_USER=scholar_user
MYSQL_PASSWORD=CHANGE_ME_db_user_pwd


# ─── [MUST] MinIO ──────────────────────────────────────────────────────────
MINIO_ROOT_USER=scholarminio
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_root_pwd


# ─── [MUST] Backend 安全 ──────────────────────────────────────────────────
# 生产强制 ≥ 32 字符随机串
JWT_SECRET=CHANGE_ME_at_least_32_chars_random


# ─── [MUST] Admin 初始账号 (仅首次启动播种) ────────────────────────────────
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=CHANGE_ME_admin_initial_pwd


# ─── [MUST] Nginx 主端口 (单一对外入口,含 /admin) ──────────────────────────
HTTP_PORT=5411


# ─── [MUST] 主域 (SEO + canonical) ─────────────────────────────────────────
SITE_URL=https://www.scholay.com


# ─── [SHOULD] CORS + WS Origin 白名单 ─────────────────────────────────────
# 同时驱动 HTTP CORS 与 WS 升级的 Origin 校验(C16)。`*` = 放行一切(dev);
# **生产改成真实域名**(逗号分隔),如 https://app.scholay.com,https://admin.scholay.com。
# docker-compose.prod.yml 用 `:?` 强制要求非空。空值在 dev 下放行一切。
CORS_ALLOWED_ORIGINS=*


# ─── [SHOULD] 品牌 / 联系邮箱 ──────────────────────────────────────────────
SITE_NAME=Scholay
SUPPORT_EMAIL=support@scholay.com


# ─── [SHOULD] MinIO bucket ────────────────────────────────────────────────
MINIO_BUCKET_PAPER_PDFS=scholar-paper-pdfs
MINIO_USE_SSL=false


# ─── [SHOULD] Umami 自托管分析 ─────────────────────────────────────────────
# 见 .env 顶部注释:单容器 + 共用 scholar_mysql + admin 自渲染图表。
# APP_SECRET 给 umami 容器自己签 token 用,生产 ≥ 32 字符随机串
UMAMI_APP_SECRET=CHANGE_ME_umami_app_secret_32chars
# 首次启动用 admin/umami 登录 umami 控制台 → 新建 Website → 拿 ID 填这里
UMAMI_WEBSITE_ID=


# ─── [SHOULD] AI Agent 内网桥接 ────────────────────────────────────────────
# scholar_agent 容器绑 0.0.0.0 时(docker 内网)自动启用 Bearer 鉴权:
# backend 调 agent /api/* 必须带 Authorization: Bearer <token>。
# 这个 token 同时给 backend 的 AGENT_AUTH_TOKEN 和 agent 的 ANTHROPIC_API_KEY,
# 单一来源避免两边对不上 401。生产请改 ≥ 32 字符随机串。
AGENT_INTERNAL_TOKEN=CHANGE_ME_agent_internal_bridge_token_32chars

# Agent 预装的 Minicod MCP server (论文/期刊检索) api key
# dev 走 agent/.env;prod compose 读这个 (改值要重启 agent 容器)
AGENT_MINICOD_API_KEY=


# ─── [生产安全 · 上线务必确认] Agent 出网收紧 + 审批模式 ────────────────────
# EGRESS_FILTER_MODE: agent 出公网的 tinyproxy 代理过滤模式(egress 服务读)。
#   open(默认)      = 放行一切外部 HTTPS,只记日志(dev 方便)。
#   allowlist        = 只放行 egress/filter 里列的域名(当前 deepseek.com + minicod.com),
#                      其余(含内网主机/IP/外泄目标)一律拒。
#   ⚠️ **生产强烈建议 allowlist** —— 这是「被 prompt-injected 的 agent 无法 SSRF/外泄」的网络层兜底。
#      换上游 provider 域名时,先把新域名加进 egress/filter 再切,否则新 provider 第一波请求被拒。
EGRESS_FILTER_MODE=open

# CLAW_PERMISSION_PASSTHROUGH: 仅 **dev / 测试** 用的审批模式开关(=1 时 claw 把 permission_request
#   透传前端人审,绕过后端自动裁决 decidePermission/specDeny)。
#   **生产不要设**(留空 = auto 自动裁决,与改造前一致);docker-compose.prod.yml 故意不含此项。
# CLAW_PERMISSION_PASSTHROUGH=


# ─── [OPTIONAL] 主动 SEO 提交 ──────────────────────────────────────────────
SEO_SUBMIT_ENABLED=false

# IndexNow (覆盖 Bing/Yandex/Naver/Seznam.cz/Yep)
INDEXNOW_ENABLED=false
INDEXNOW_KEY=

# 百度普通收录推送 (Token 在 https://ziyuan.baidu.com)
BAIDU_PUSH_ENABLED=false
BAIDU_PUSH_TOKEN=
BAIDU_PUSH_SITE=www.scholay.com
BAIDU_PUSH_DAILY_QUOTA=1000

SEO_PUSH_WORKER_INTERVAL_SECONDS=300
SEO_PUSH_BATCH_SIZE=100
