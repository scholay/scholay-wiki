# MySQL Configuration (仅容器内部使用,不暴露到主机)
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=scholar
MYSQL_USER=scholar_user
MYSQL_PASSWORD=scholar_pass

# Backend Configuration
# IMPORTANT: In production, set a strong secret (>= 16 characters)
JWT_SECRET=your-secret-key-change-in-production

# CORS Configuration (comma-separated list of allowed origins)
# Leave empty to allow all origins without credentials
# CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com

# Frontend URL (used for invitation links, etc.)
# FRONTEND_USER_URL=https://yourdomain.com

# Nginx Port Configuration (defaults match docker-compose.yml)
HTTP_PORT=5411        # 访问端口（用户端 + 管理台统一入口）

# SigNoz Observability (optional)
# SIGNOZ_ENDPOINT=http://198.44.187.186:4318
# SIGNOZ_ENVIRONMENT=production
# SIGNOZ_ENABLE_TRACING=true
# SIGNOZ_ENABLE_LOGGING=true
# SIGNOZ_ENABLE_METRICS=true
