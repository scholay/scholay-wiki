# MySQL Configuration (仅容器内部使用,不暴露到主机)
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=scholar
MYSQL_USER=scholar_user
MYSQL_PASSWORD=scholar_pass

# Backend Configuration
JWT_SECRET=your-secret-key-change-in-production

# SEO — sitemap <loc> 和 HTML canonical 标签使用的站点权威域名
# 必须和搜索引擎后台（Google Search Console / 百度资源平台）提交的资源地址一致
# 默认 https://scholay.com（无 www）；改前记得在搜索引擎后台同步切换资源
SEO_BASE_URL=https://scholay.com

# Nginx Port Configuration
HTTP_PORT=80          # 用户端访问端口
ADMIN_PORT=8001       # 管理台访问端口
