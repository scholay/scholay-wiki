                                                            {
                                                              "type": "text",
                                                              "id": "Wm1OE",
                                                              "name": "政策分析学科要求任何政策建议在提出前必须通过「二阶效应压力测试」：该政策在被规避、被曲解、被选择性执行三种情景下分 别产生什么结果(Merton 1936; Sieber 1981)",
                                                              "fill": "#666666ff",
                                                              "textGrowth": "fixed-width",
                                                              "width": "fill_container",
                                                              "content": "政策分析学科要求任何政策建议在提出前必须通过「二阶效应压力测试」：该政策在被规避、被曲解、被选择性执行三种情景下分\n别产生什么结果(Merton 1936; Sieber 1981)",
                                                              "lineHeight": 1.625,
                                                              "textAlignVertical": "middle",
                                                              "fontFamily": "PingFang SC",
                                                              "fontSize": 12,
                                                              "fontWeight": "normal"
                                                            }
