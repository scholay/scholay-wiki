                                                {
                                                  "type": "text",
                                                  "id": "TmwmP",
                                                  "name": "We propose a hybrid architecture that combines the linear-time inference of state-space models with the in-context learning ability of attention.",
                                                  "fill": "#444444ff",
                                                  "textGrowth": "fixed-width",
                                                  "width": "fill_container",
                                                  "content": "We propose a hybrid architecture that combines the linear-time\ninference of state-space models with the in-context learning\nability of attention.",
                                                  "lineHeight": 1.700000069358132,
                                                  "textAlignVertical": "middle",
                                                  "fontFamily": "SF Pro",
