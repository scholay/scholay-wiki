                                                            {
                                                              "type": "text",
                                                              "id": "DLG98",
                                                              "name": "多层级治理(multi-level governance)研究范式要求逐一分析各治理层级的制度激励与能力约束(Hooghe & Marks 2001)。在遗 产领域，Schmitt(2009)和Rodwell(2012)均采用了分层分析法",
                                                              "fill": "#666666ff",
                                                              "textGrowth": "fixed-width",
                                                              "width": "fill_container",
                                                              "content": "多层级治理(multi-level governance)研究范式要求逐一分析各治理层级的制度激励与能力约束(Hooghe & Marks 2001)。在遗\n产领域，Schmitt(2009)和Rodwell(2012)均采用了分层分析法",
                                                              "lineHeight": 1.625,
                                                              "textAlignVertical": "middle",
                                                              "fontFamily": "SF Pro",
                                                              "fontSize": 12,
                                                              "fontWeight": "normal"
                                                            }
                                                          ]
                                                        }
