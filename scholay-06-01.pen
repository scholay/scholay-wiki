                                                        {
                                                          "type": "frame",
                                                          "id": "ROTrd",
                                                          "name": "Container",
                                                          "width": "fill_container",
                                                          "height": "fill_container",
                                                          "layout": "vertical",
                                                          "children": [
                                                            {
                                                              "type": "text",
                                                              "id": "Eeenf",
                                                              "name": "论文将「世界遗产治理」作为一个整体来分析，未区分治理体系内部的制度分层：老挝中央政府(文化部)、琅勃拉邦省政府 (LPWHO)、地方社区、国际组织(UNESCO WHC/ICOMOS)四层之间在权责、资金和议程上存在显著张力，论文将其合并处理导 致政策分析失去粒度",
                                                              "fill": "#444444ff",
                                                              "textGrowth": "fixed-width",
                                                              "width": "fill_container",
                                                              "content": "论文将「世界遗产治理」作为一个整体来分析，未区分治理体系内部的制度分层：老挝中央政府(文化部)、琅勃拉邦省政府\n(LPWHO)、地方社区、国际组织(UNESCO WHC/ICOMOS)四层之间在权责、资金和议程上存在显著张力，论文将其合并处理导\n致政策分析失去粒度",
                                                              "lineHeight": 1.625,
                                                              "textAlignVertical": "middle",
                                                              "fontFamily": "PingFang SC",
                                                              "fontSize": 12,
                                                              "fontWeight": "normal"
                                                            }
                                                          ]
                                                        }
                                                      ]
                                                    },
                                                    {
                                                      "type": "frame",
                                                      "id": "b7lWI",
                                                      "name": "Container",
                                                      "width": "fill_container",
