                                                    {
                                                      "type": "frame",
                                                      "id": "cgHik",
                                                      "name": "Container",
                                                      "width": "fill_container",
                                                      "layout": "vertical",
                                                      "children": [
                                                        {
                                                          "type": "text",
                                                          "id": "O9l1k",
                                                          "name": "论文以琅勃拉邦为核心案例，其治理框架(OUV/PSMV/HIA)有很强的UNESCO特异性。但结论中的「空间-技艺系统」框架被表述为一般性理 论命题。读者自然会问：将这一框架应用于非世界遗产城市(如万象的老挝传统住区)时，哪些分析维度仍然有效、哪些需要调整？论文应在结 论中明确划定该框架的有效性边界(appliability boundary)，区分适用于世界遗产治理语境的分析工具与适用于一般老挝民居研究的分析工具",
                                                          "fill": "#444444ff",
                                                          "textGrowth": "fixed-width",
                                                          "width": "fill_container",
                                                          "content": "论文以琅勃拉邦为核心案例，其治理框架(OUV/PSMV/HIA)有很强的UNESCO特异性。但结论中的「空间-技艺系统」框架被表述为一般性理\n论命题。读者自然会问：将这一框架应用于非世界遗产城市(如万象的老挝传统住区)时，哪些分析维度仍然有效、哪些需要调整？论文应在结\n论中明确划定该框架的有效性边界(appliability boundary)，区分适用于世界遗产治理语境的分析工具与适用于一般老挝民居研究的分析工具",
                                                          "lineHeight": 1.625,
                                                          "textAlignVertical": "middle",
                                                          "fontFamily": "PingFang SC",
                                                          "fontSize": 12,
                                                          "fontWeight": "normal"
                                                        }
                                                      ]
                                                    }
