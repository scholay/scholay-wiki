                                                        },
                                                        {
                                                          "type": "frame",
                                                          "id": "GoUEX",
                                                          "name": "Container",
                                                          "width": "fill_container",
                                                          "height": "fill_container",
                                                          "layout": "vertical",
                                                          "children": [
                                                            {
                                                              "type": "text",
                                                              "id": "NF1Pq",
                                                              "name": "论文将危机归因于三重结构因素但未讨论任何缓解政策的潜在二阶效应(unintended consequences)。例如，严格执行PSMV的 材料限制条款可能导致：(1)低收入居民无力承担传统材料维护成本而被迫搬离，(2)催生「遗产化贫困」(heritage-induced poverty)，(3)非正式建造活动向监管盲区转移",
                                                              "fill": "#444444ff",
                                                              "textGrowth": "fixed-width",
                                                              "width": "fill_container",
                                                              "content": "论文将危机归因于三重结构因素但未讨论任何缓解政策的潜在二阶效应(unintended consequences)。例如，严格执行PSMV的\n材料限制条款可能导致：(1)低收入居民无力承担传统材料维护成本而被迫搬离，(2)催生「遗产化贫困」(heritage-induced\npoverty)，(3)非正式建造活动向监管盲区转移",
                                                              "lineHeight": 1.625,
                                                              "textAlignVertical": "middle",
                                                              "fontFamily": "PingFang SC",
                                                              "fontSize": 12,
                                                              "fontWeight": "normal"
                                                            }
                                                          ]
                                                        }
                                                      ]
                                                    },
