                                                          "children": [
                                                            {
                                                              "type": "text",
                                                              "id": "VN3yD",
                                                              "name": "研究展望仅列出学术研究方向，完全没有涉及本研究的政策含义(policy implications)。一篇以「技艺传承」和「遗产治理」为核 心关键词的论文，在结论中未写一行关于政策建议的文字，这是重大的结构缺失",
                                                              "fill": "#444444ff",
                                                              "textGrowth": "fixed-width",
                                                              "width": "fill_container",
                                                              "content": "研究展望仅列出学术研究方向，完全没有涉及本研究的政策含义(policy implications)。一篇以「技艺传承」和「遗产治理」为核\n心关键词的论文，在结论中未写一行关于政策建议的文字，这是重大的结构缺失",
                                                              "lineHeight": 1.625,
                                                              "textAlignVertical": "middle",
                                                              "fontFamily": "PingFang SC",
                                                              "fontSize": 12,
                                                              "fontWeight": "normal"
                                                            }
                                                          ]
                                                        }
