                                                      "children": [
                                                        {
                                                          "type": "text",
                                                          "id": "kxvwK",
                                                          "name": "当老挝传统干栏式建筑进入世界遗产语境时，它不再只是民族民居或地方住宅，而成为城市景观、生活遗产和 OUV 属性的一部分",
                                                          "fill": "#444444ff",
                                                          "content": "当老挝传统干栏式建筑进入世界遗产语境时，它不再只是民族民居或地方住宅，而成为城市景观、生活遗产和 OUV 属性的一部分",
                                                          "lineHeight": 1.4283332824707031,
                                                          "textAlignVertical": "middle",
                                                          "fontFamily": "PingFang SC",
                                                          "fontSize": 12,
                                                          "fontWeight": "normal"
                                                        }
                                                      ]
                                                    },
                                                    {
