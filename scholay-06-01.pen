                                                {
                                                  "type": "text",
                                                  "id": "K4S473",
                                                  "name": "\\section{Method} \\label{sec:method}",
                                                  "fill": "#e6e6e6ff",
                                                  "content": "\\section{Method}\n\\label{sec:method}",
                                                  "lineHeight": 1.6499999653209338,
                                                  "textAlignVertical": "middle",
                                                  "fontFamily": "Menlo",
                                                  "fontSize": 11,
                                                  "fontWeight": "normal"
                                                },
                                                {
                                                  "type": "text",
                                                  "id": "crvs8",
                                                  "name": "We propose a hybrid architecture that combines the linear-time inference of state-space models with the in-context learning ability of attention.",
                                                  "fill": "#e6e6e6ff",
                                                  "content": "We propose a hybrid architecture that combines\nthe linear-time inference of state-space models\nwith the in-context learning ability of attention.",
                                                  "lineHeight": 1.6499999653209338,
                                                  "textAlignVertical": "middle",
                                                  "fontFamily": "Menlo",
                                                  "fontSize": 11,
                                                  "fontWeight": "normal"
                                                },
                                                {
                                                  "type": "text",
                                                  "id": "Shxsc",
                                                  "name": "\\subsection{Block Design} Each block consists of: \\begin{itemize} \\item A Mamba-style SSM branch for long-range \\item A windowed attention branch for local \\item A gating function that blends the two \\end{itemize}",
                                                  "fill": "#e6e6e6ff",
                                                  "content": "\\subsection{Block Design}\nEach block consists of:\n\\begin{itemize}\n  \\item A Mamba-style SSM branch for long-range\n  \\item A windowed attention branch for local\n  \\item A gating function that blends the two\n\\end{itemize}",
                                                  "lineHeight": 1.6499999653209338,
                                                  "textAlignVertical": "middle",
                                                  "fontFamily": "Menlo",
                                                  "fontSize": 11,
                                                  "fontWeight": "normal"
                                                },
                                                {
                                                  "type": "text",
                                                  "id": "rLhG6",
                                                  "name": "The blended output is then normalized via...",
                                                  "fill": "#e6e6e6ff",
                                                  "content": "The blended output is then normalized via...",
                                                  "lineHeight": 1.6499999653209338,
                                                  "textAlignVertical": "middle",
                                                  "fontFamily": "Menlo",
                                                  "fontSize": 11,
                                                  "fontWeight": "normal"
                                                }
                                              ]
                                            }
