                                              "children": [
                                                {
                                                  "type": "text",
                                                  "id": "x1bNa",
                                                  "name": "Each block consists of a Mamba-style SSM branch for long- range dependencies, a windowed attention branch for local detail, and a gating function that blends the two streams.",
                                                  "fill": "#444444ff",
                                                  "textGrowth": "fixed-width",
                                                  "width": "fill_container",
                                                  "content": "Each block consists of a Mamba-style SSM branch for long-\nrange dependencies, a windowed attention branch for local\ndetail, and a gating function that blends the two streams.",
                                                  "lineHeight": 1.700000069358132,
                                                  "textAlignVertical": "middle",
                                                  "fontFamily": "SF Pro",
                                                  "fontSize": 11,
                                                  "fontWeight": "normal",
                                                  "letterSpacing": 0.06599999964237213
                                                }
                                              ]
                                            },
                                            {
                                              "type": "frame",
                                              "id": "Uzz69",
                                              "name": "Container",
                                              "width": "fill_container",
                                              "layout": "vertical",
                                              "children": [
                                                {
                                                  "type": "text",
                                                  "id": "AIDiP",
                                                  "name": "The blended output is then normalized via RMSNorm, fed through a two-layer GLU MLP, and added back with a residual connection.",
                                                  "fill": "#444444ff",
                                                  "textGrowth": "fixed-width",
                                                  "width": "fill_container",
                                                  "content": "The blended output is then normalized via RMSNorm, fed\nthrough a two-layer GLU MLP, and added back with a residual\nconnection.",
                                                  "lineHeight": 1.700000069358132,
                                                  "textAlignVertical": "middle",
                                                  "fontFamily": "SF Pro",
                                                  "fontSize": 11,
                                                  "fontWeight": "normal",
                                                  "letterSpacing": 0.06599999964237213
                                                }
                                              ]
                                            }
