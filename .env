# MySQL Configuration (仅容器内部使用,不暴露到主机)
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=scholar
MYSQL_USER=scholar_user
MYSQL_PASSWORD=scholar_pass

# Backend Configuration
JWT_SECRET=your-secret-key-change-in-123456

# Admin Initial Configuration
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=adminadmin
ADMIN_INITIAL_EMAIL=admin@scholar.local

# Nginx Port Configuration
HTTP_PORT=5411          # 用户端访问端口
ADMIN_PORT=5455       # 管理台访问端口

# Agent API Configuration (V2 审稿)
AGENT_API_URL=http://host.docker.internal:8200
AGENT_API_TOKEN=

# SigNoz 日志采集配置
SIGNOZ_ENDPOINT=198.44.187.186:4318
SIGNOZ_SERVICE_NAME=scholar-backend
SIGNOZ_ENVIRONMENT=production
SIGNOZ_ENABLE_TRACING=true
SIGNOZ_ENABLE_LOGGING=true
SIGNOZ_ENABLE_METRICS=true
SIGNOZ_SAMPLING_RATE=1.0