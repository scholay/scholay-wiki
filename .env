# ============================================================================
# Scholay 环境变量
#
# 分三段:
#   [MUST]      必填 —— 缺了 docker-compose 起不来或核心功能不可用
#   [SHOULD]    推荐填 —— 有默认值但属于开发占位符,生产必须改
#   [OPTIONAL]  可选 —— 留空时代码优雅降级,不影响其他功能
#
# 同步规则:
#   - .env.example 跟本文件结构一致,值替换成占位符
#   - frontend-v2/.env.example 只放 VITE_* 子集 (Vite build-time 注入)
#   - docker-compose.yml 用 `${VAR}` 引用,带默认值的格式 `${VAR:-default}`
# ============================================================================


# ─── [MUST] MySQL ─────────────────────────────────────────────────────────
# 容器内部访问,不暴露主机。MYSQL_ROOT_PASSWORD 也给 schema-sync 用 (它要 root
# 权限自动 CREATE umami 库并 GRANT 给 scholar_user,见 scripts/run-migrations.sh)。
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=scholar
MYSQL_USER=scholar_user
MYSQL_PASSWORD=scholar_pass


# ─── [MUST] MinIO (用户上传 PDF) ────────────────────────────────────────────
# 仅容器内部访问。生产环境必须改 ROOT_PASSWORD;bucket 名后端启动时自动建。
MINIO_ROOT_USER=scholarminio
MINIO_ROOT_PASSWORD=scholarminiopass


# ─── [MUST] Backend 安全 ──────────────────────────────────────────────────
# JWT 签名密钥。生产强制 ≥ 32 字符随机串,改了所有用户需要重新登录。
JWT_SECRET=your-secret-key-change-in-123456


# ─── [MUST] Admin 初始账号 ────────────────────────────────────────────────
# 首次启动 schema-sync 时自动播种;之后改密在 admin /password 页内做,改这里没用。
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=adminadmin


# ─── [MUST] Nginx 主端口 ───────────────────────────────────────────────────
# 单一对外入口 (/admin 路径同走这个端口,权限在后端 JWT 校验)。
HTTP_PORT=5411

# ─── 测试支付(仅本地/演示)──────────────────────────────────────────────────
# true → 「账户资产」充值/订阅出现"测试支付"按钮, 下单后一键完成履约(不走真实网关)。
# 生产环境务必保持 false。
PAYMENT_TEST_ENABLED=true


# ─── [MUST] 主域 (SEO + canonical) ─────────────────────────────────────────
# sitemap loc / og:url / JSON-LD url 全用这个。必须带 www;apex 走 301 → www。
SITE_URL=https://www.scholay.com


# ─── [SHOULD] CORS ────────────────────────────────────────────────────────
# 默认 `*` 允许任意 origin (开发友好,但禁用 cookies 凭据)。
# 生产改为逗号分隔白名单:https://app.scholay.com,https://admin.scholay.com
CORS_ALLOWED_ORIGINS=*


# ─── [SHOULD] 品牌 / 联系邮箱 (前后端 fan-out) ──────────────────────────────
# docker-compose.yml 把这些值拆给 backend env + frontend build args:
#   backend  : SEO_BASE_URL/SUPPORT_EMAIL/SITE_NAME
#   frontend : REACT_APP_SITE_URL/_SITE_NAME/_SUPPORT_EMAIL + VITE_SITE_URL/_SITE_NAME
SITE_NAME=Scholay
SUPPORT_EMAIL=support@scholay.com

# ─── [临时] 智能写作 (Prism)「即将推出」门 ──────────────────────────────────
# true  = 菜单加「即将推出」角标 + /prism 页面盖蒙层(本版先上线,Prism 还在迭代)。
# false = 放行真实 Prism(等正式上线时改这里 + 重新 build-and-push)。
# 仅 build-time(Vite),改值要重新构建前端镜像。build-and-push.sh 未设时兜底 true。
PRISM_COMING_SOON=false


# ─── [SHOULD] MinIO bucket / 协议 ─────────────────────────────────────────
# 默认值合理,生产环境用 SSL 时改 true。bucket 名后端启动时自动创建。
MINIO_BUCKET_PAPER_PDFS=scholar-paper-pdfs
MINIO_USE_SSL=false


# ─── [SHOULD] Umami 自托管分析 (共用 scholar_mysql) ────────────────────────
# 架构:
#   - 单容器 scholar_umami,镜像 mysql-latest,DATABASE_URL 指 scholar_mysql 的 `umami` 库
#     (umami 库 + 权限由 schema-sync 启动时用 root 自动 CREATE + GRANT)
#   - umami UI 不再对外暴露 —— admin /analytics 走 backend HTTP API 自渲染图表
#   - tracker website_id 由 backend 自动 bootstrap (首次访问 /api/v1/public/umami-config
#     时 list umami websites,空就创建一个 Scholay/SITE_URL 并缓存) → 下面留空即可
#   - tracker (`/umami-embed/script.js` 与 `/api/send`) 走主 nginx,前端 index.html 加载时
#     fetch /api/v1/public/umami-config 拿 id,动态插入 tracker 脚本
#   - backend 用 umami 默认 admin/umami 登录拿 token (不要改 umami 内部密码)
# APP_SECRET 给 umami 容器自己签 token 用,改值需要重启 umami;生产 ≥ 32 字符随机串。
UMAMI_APP_SECRET=openscholay-umami-secret-2024
# 可选 override —— 已经有别的 umami website 想强制用就填这个 UUID;
# 留空(推荐)→ backend 自动 bootstrap,新装实例 / DB 重建后零手工。
UMAMI_WEBSITE_ID=

# ─── AI Agent 内网桥接 token ─────────────────────────────────────────────
# scholar_agent 容器绑 0.0.0.0 时自动开 Bearer 鉴权;backend 调 agent /api/*
# 必须带这个 token。docker-compose 同时把它注入 agent (ANTHROPIC_API_KEY) 和
# backend (AGENT_AUTH_TOKEN) —— 单一来源,改一处生效两边。
AGENT_INTERNAL_TOKEN=internal-bridge-token-change-me-in-prod

# ─── Agent 预装 MCP server: Minicod (论文/期刊检索) ───────────────────
# dev compose 通过 env_file: agent/.env 直接读;prod compose 用这个变量 fan-out。
# 改值要重启 agent 容器 (preinstalled-mcp.json 启动时展开,不支持热更)。
AGENT_MINICOD_API_KEY=sk-a0401b7fe164ba9d0fa422b99376e8a357648b101f044f71e0ae427ff8e682b4


# ─── [OPTIONAL] 主动 SEO 提交 ──────────────────────────────────────────────
# 写入 seo_papers / seo_authors 后,backend worker 把 URL 推到搜索引擎。
# 总开关关时整套静默(worker 不启动、不 bootstrap seed),完全可选。
#
# ⚠️ 这是「是否真的对外推送」的总闸,本地务必保持 false:
#    一旦设 true,本地 worker 会每 5 分钟真的 POST 到 api.indexnow.org,
#    且推送的是 https://www.scholay.com/... 的 URL(siteOrigin 取 canonical 域名,
#    不是 localhost)。本地无法伺服 scholay.com/{KEY}.txt,提交会被搜索引擎拒收,
#    纯属白发请求 + 刷错误日志;若生产恰好用同一个 KEY,还会变成"本地替生产推",更乱。
#    ✅ 正确做法:KEY 和 INDEXNOW_ENABLED 先在这里配好(下面已配),
#       但 SEO_SUBMIT_ENABLED 只在【生产环境的 .env】里设 true。
SEO_SUBMIT_ENABLED=false

# IndexNow 协议 (覆盖 Bing / Yandex / Naver / Seznam.cz / Yep)
# Key: 8-128 位字符 [a-zA-Z0-9-],自己生成,需要在 https://www.scholay.com/{KEY}.txt 200 OK
#      backend 已自动注册 GET /{KEY}.txt 路由,部署后无需另外放静态文件
INDEXNOW_ENABLED=true
INDEXNOW_KEY=1e15fc63b87d75c5b486ff453ccb4741

# 百度普通收录推送
# Token 在 https://ziyuan.baidu.com → 普通收录 → API 推送 处获取
# Site 是已验证的站点 host,不带 https:// (如 www.scholay.com)
BAIDU_PUSH_ENABLED=false
BAIDU_PUSH_TOKEN=
BAIDU_PUSH_SITE=www.scholay.com
BAIDU_PUSH_DAILY_QUOTA=1000

# Worker 节奏 (默认 5 分钟一轮,每轮 100 条 URL)
SEO_PUSH_WORKER_INTERVAL_SECONDS=300
SEO_PUSH_BATCH_SIZE=100

# ─── Web-native 重构:agent 事件溯源脊柱(2026-06,P0+P1)。opt-in,可删行回退 ───
# shadow=影子写 turn 账本/事件日志(jsonl+内存 hub 仍权威);on=后台校验 journal==daemon;
# READ 留空=历史/续流仍走 daemon(最安全)。要测 P1 读路径再设 AGENT_JOURNAL_READ=smart_search。
AGENT_TURN_JOURNAL=shadow
AGENT_JOURNAL_VALIDATE=on
AGENT_JOURNAL_READ=

# Minicod MCP key (agent;源同 agent/.env)
MINICOD_API_KEY=sk-a0401b7fe164ba9d0fa422b99376e8a357648b101f044f71e0ae427ff8e682b4

# agent(clean-room executor)路由:唯一后端,与 AGENT_BASE_URL 同一 scholar_agent
AGENT_EXECUTOR_BASE_URL=http://scholar_agent:3456
AGENT_EXECUTOR_FEATURES=smart_search,claw,prism,peerreview
