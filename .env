# MySQL Configuration (仅容器内部使用,不暴露到主机)
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=scholar
MYSQL_USER=scholar_user
MYSQL_PASSWORD=scholar_pass

# Backend Configuration
JWT_SECRET=your-secret-key-change-in-123456

# Admin Initial Configuration
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=adminadmin
ADMIN_INITIAL_EMAIL=admin@scholar.local

# Nginx Port Configuration
# 站点对外只暴露一个端口,/admin 路径由同一个 SPA 处理,权限在后端 JWT 校验
HTTP_PORT=5411

# ============================================================================
# 站点 / 品牌 / 第三方服务地址(每项只在这里写一次)
# docker-compose.yml 把这些值 fan-out 到:
#   - 后端容器 env(SEO_BASE_URL / SUPPORT_EMAIL / ...)
#   - 前端 build args(REACT_APP_SITE_URL / REACT_APP_SUPPORT_EMAIL / ...)
# 详见 docker-compose.yml 里 backend / frontend-user 的 environment / args 段。
# ============================================================================

# 主域(权威 host),sitemap loc / canonical / og:url 都基于此
# 必须带 www;apex 通过反代层 301 → www
SITE_URL=https://www.scholay.com

# 品牌名(JSON-LD 结构化数据中显示)
SITE_NAME=Scholay

# 公开支持邮箱(法律页 / 联系页 / FAQ 文案展示)
SUPPORT_EMAIL=support@scholay.com

# Unpaywall 调用要带的联系邮箱(Unpaywall API 礼仪要求)
UNPAYWALL_EMAIL=api@scholay.com

# 外部 PDF 服务(完整 endpoint,后端调用)
PDF_SERVICE_URL=https://pdf.scholay.com/api/v1/pdf

# 前端 PDF 预览代理(浏览器侧调用,带路径)
PDF_PREVIEW_ENDPOINT=https://filepreview.scholay.com/api/preview

# ============================================================================
# 主动 SEO 提交 (Active SEO Submission)
# 写入 seo_papers / seo_authors 后,backend worker 把 URL 推到搜索引擎。
# 对接:IndexNow(覆盖 Bing / Yandex / Naver / Seznam.cz / Yep) + 百度推送 API
# Google 不收第三方推送,依赖 sitemap + GSC 自然抓取。
# ============================================================================

# 总开关 —— 为 false 时入队 / worker 全部静默
SEO_SUBMIT_ENABLED=false

# IndexNow 协议
# Key: 8-128 位字符 [a-zA-Z0-9-],自己生成,需要在 https://www.scholay.com/{KEY}.txt 200 OK
#      backend 已自动注册 GET /{KEY}.txt 路由,部署后无需另外放静态文件
INDEXNOW_ENABLED=false
INDEXNOW_KEY=

# 百度普通收录推送
# Token 在 https://ziyuan.baidu.com → 普通收录 → API 推送 处获取
# Site 是已验证的站点 host,不带 https://(如 www.scholay.com)
BAIDU_PUSH_ENABLED=false
BAIDU_PUSH_TOKEN=
BAIDU_PUSH_SITE=www.scholay.com
BAIDU_PUSH_DAILY_QUOTA=1000

# Worker 节奏
SEO_PUSH_WORKER_INTERVAL_SECONDS=300   # 5 分钟一轮
SEO_PUSH_BATCH_SIZE=100                # 每轮拉 100 条 URL