                              "type": "text",
                              "id": "m4J31",
                              "fill": "#0A0A0A",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Diffusion-Augmented Reasoning: Scaling Latent Search for Chain-of-Thought Models",
