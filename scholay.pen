                                      "content": "引用了 §1 高亮句",
                                      "fontFamily": "Inter",
                                      "fontSize": 10,
                                      "fontWeight": "normal"
                                    }
                                  ]
                                },
                                {
                                  "type": "frame",
                                  "id": "BCFWa",
                                  "name": "u1Bub",
                                  "width": 380,
                                  "fill": "#111111",
                                  "cornerRadius": 14,
                                  "padding": [
                                    10,
                                    14
                                  ],
                                  "children": [
                                    {
                                      "type": "text",
                                      "id": "TtDuR",
                                      "fill": "#FFFFFF",
                                      "textGrowth": "fixed-width",
                                      "width": "fill_container",
                                      "content": "U-Net 这类编码器-解码器结构相比新的 Transformer 方法，主要的归纳偏置体现在哪里？为什么它在小数据集上往往更稳定？",
                                      "lineHeight": 1.6,
                                      "fontFamily": "Inter",
                                      "fontSize": 13,
                                      "fontWeight": "normal"
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "pMx7R",
                          "name": "aiMsg1",
                          "width": "fill_container",
                          "gap": 10,
                          "children": [
                            {
                              "type": "frame",
                              "id": "iIvRc",
                              "name": "a1Av",
                              "width": 28,
                              "height": 28,
                              "fill": "#111111",
                              "cornerRadius": 14,
                              "justifyContent": "center",
                              "alignItems": "center",
                              "children": [
                                {
                                  "type": "icon",
                                  "id": "hHtJh",
                                  "width": 13,
                                  "height": 13,
                                  "icon": "sparkles",
                                  "library": "lucide",
                                  "fill": "#FFD24D"
                                }
                              ]
                            },
                            {
                              "type": "frame",
                              "id": "Pkub8",
                              "name": "a1Col",
                              "width": "fill_container",
                              "layout": "vertical",
                              "gap": 8,
                              "children": [
                                {
                                  "type": "frame",
                                  "id": "zdhUM",
                                  "name": "a1Bub",
                                  "width": "fill_container",
                                  "fill": "#FAFAFA",
                                  "cornerRadius": 14,
                                  "stroke": "#EFEFEF",
                                  "strokeWidth": 1,
                                  "layout": "vertical",
                                  "gap": 8,
                                  "padding": [
                                    12,
                                    14
                                  ],
                                  "children": [
                                    {
                                      "type": "text",
                                      "id": "RL7Xm",
                                      "fill": "#222222",
                                      "textGrowth": "fixed-width",
                                      "width": "fill_container",
                                      "content": "根据本文 §1 的论述，U-Net 引入了两个关键的归纳偏置：(1) 对称的编码器–解码器结构强制网络在不同空间分辨率上同时建模上下文与局部细节；(2) 跨层级的跳跃连接保留了高分辨率的边界信息，使分割结果在小样本下依然稳定。",
                                      "lineHeight": 1.7,
                                      "fontFamily": "Inter",
                                      "fontSize": 13,
                                      "fontWeight": "normal"
                                    },
                                    {
                                      "type": "text",
                                      "id": "uckeE",
                                      "fill": "#222222",
                                      "textGrowth": "fixed-width",
                                      "width": "fill_container",
                                      "content": "相比之下，Transformer 主干 (如 Swin-Unet, TransUNet) 拥有更强的全局建模能力，但其优势主要在 大数据 + 预训练 场景下显现 —— 在每类标注少于 50 例的临床数据上，性能往往与 U-Net 持平或更差。",
                                      "lineHeight": 1.7,
                                      "fontFamily": "Inter",
                                      "fontSize": 13,
                                      "fontWeight": "normal"
                                    }
                                  ]
                                },
                                {
                                  "type": "frame",
                                  "id": "sjRHO",
                                  "name": "a1Cite",
                                  "width": "fill_container",
                                  "gap": 6,
