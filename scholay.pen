                                      "type": "text",
                                      "id": "vKJLM",
                                      "fill": "#111111",
                                      "textGrowth": "fixed-width",
                                      "width": "fill_container",
                                      "content": "Explainable AI in Medical Imaging: A Survey of XAI Methods 2021-2024",
                                      "lineHeight": 1.4,
                                      "fontFamily": "Inter",
                                      "fontSize": 16,
                                      "fontWeight": "700"
                                    },
                                    {
                                      "type": "text",
                                      "id": "heMOf",
                                      "fill": "#555555",
                                      "textGrowth": "fixed-width",
                                      "width": "fill_container",
                                      "content": "系统综述 2021-2024 年 Grad-CAM、SHAP、LIME、Integrated Gradients 在医学影像各亚领域的发展脉络与临床落地挑战，覆盖 86 个临床试点与 172 篇文献。",
                                      "lineHeight": 1.7,
