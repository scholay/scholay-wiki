                      "children": [
                        {
                          "type": "text",
                          "id": "LGnYd",
                          "fill": "#111111",
                          "content": "3.  Methods",
                          "fontFamily": "Playfair Display",
                          "fontSize": 18,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "YUFsN",
                          "fill": "#444444",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "In this work, we propose a hierarchical attention U-Net (HA-UNet) for multi-organ segmentation across CT and MRI modalities. Unlike prior approaches, HA-UNet integrates a learnable channel-wise gating mechanism that adapts to modality-specific intensity distributions.",
                          "lineHeight": 1.7,
                          "fontFamily": "Inter",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        },
                        {
                          "type": "frame",
                          "id": "s5qBt",
                          "name": "hl",
                          "width": "fill_container",
                          "fill": "#FFF3C2",
                          "layout": "vertical",
                          "padding": [
                            2,
                            4
                          ],
                          "children": [
                            {
                              "type": "text",
                              "id": "bswQy",
                              "fill": "#111111",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "We achieve a mean Dice score of 0.913 on the AMOS-CT benchmark, outperforming nnUNet (0.887) and Swin-UNETR (0.901) while reducing inference time by 38%.",
                              "lineHeight": 1.7,
                              "fontFamily": "Inter",
                              "fontSize": 13,
                              "fontWeight": "500"
                            }
                          ]
                        },
                        {
                          "type": "frame",
                          "id": "J7cyk",
