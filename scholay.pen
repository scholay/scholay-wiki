                                          "fill": "#222222",
                                          "content": "Sincerely,",
                                          "fontFamily": "Inter",
                                          "fontSize": 13,
                                          "fontWeight": "normal"
                                        },
                                        {
                                          "type": "text",
                                          "id": "f3ftT",
