                        },
                        {
                          "type": "text",
                          "id": "hOpEq",
                          "fill": "#111111",
                          "content": "3.1  Network Architecture",
                          "fontFamily": "Playfair Display",
                          "fontSize": 15,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "MV2o3",
                          "fill": "#444444",
                          "textGrowth": "fixed-width",
                          "width": "fill_container",
                          "content": "The encoder follows a five-stage hierarchical design with channel dimensions {64, 128, 256, 512, 1024}. Each stage applies depthwise separable convolutions followed by a residual squeeze-and-excitation block.",
                          "lineHeight": 1.7,
                          "fontFamily": "Inter",
                          "fontSize": 13,
                          "fontWeight": "normal"
                        }
                      ]
