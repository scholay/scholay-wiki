# Environment variables
.env
# 线上 .env 母本(含生产密钥,只在本地维护、scp 到服务器,严禁入库)
.env.prod

# Data directories —— 仅忽略仓库根的运行时数据卷 (mysql/redis/minio/agent/... 等容器持久化)。
# 必须带前导 `/` 锚定到根: 不带 `/` 的 `data/` 会匹配【任意层级】的 data 目录, 会误伤
# frontend-user/src/features/{help,landing}/data 这类源码 (帮助/博客/资源/落地页内容)。
/data/
!/data/.gitkeep

# Backend
backend/tmp/
backend/bin/
backend/.go-cache/
.go-cache/
# Go 模块校验缓存(docker build 挂载出的 GOMODCACHE 副本,本机实测 2.7GB):
# 从未跟踪但此前无规则覆盖 —— 一次手滑 `git add .` 就会把它灌进历史,显式封死。
backend/.gomodcache-verify/
.gomodcache-verify/
backend/.gocache-verify/
.gocache-verify/
*.exe
# 编译产物二进制 —— Docker 构建从源码重编,不该进 git(曾误提 ~48MB 进历史)。
/backend/server
/backend/seo-backfill
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# TypeScript 增量编译状态(tsc --build 产物):机器相关、每次构建必变,曾被误跟踪
# (frontend-user/tsconfig.*.tsbuildinfo)混进 diff 制造噪音 —— 全局剔除。
*.tsbuildinfo

# Frontend
# 所有 Node.js 包的本地依赖目录（根目录及任意子项目）都由 lockfile 重建，严禁入库。
node_modules/
frontend-admin/node_modules/
frontend-admin/build/
frontend-admin/.pnp
frontend-admin/.pnp.js
frontend-user/node_modules/
frontend-user/build/
frontend-user/.pnp
frontend-user/.pnp.js
frontend-user/dist/

# Testing
coverage/

# IDE and OS
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# AI tool configs
.claude/

# Backup files
*.bak

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
backups/

# Generated feature-tool import packs and crawl cache
/feature-tools-academic-1000/
/feature-tools-academic-1000-batch-*/
/feature-tools-academic-5000/
/feature-tools-academic-audit/
/.feature-tools-academic-10k-cache/
feature-tools-coldstart/
