# Environment variables
# .env

# Data directories —— 仅忽略仓库根的运行时数据卷 (mysql/redis/minio/agent/... 等容器持久化)。
# 必须带前导 `/` 锚定到根: 不带 `/` 的 `data/` 会匹配【任意层级】的 data 目录, 会误伤
# frontend-user/src/features/{help,landing}/data 这类源码 (帮助/博客/资源/落地页内容)。
/data/
!/data/.gitkeep

# Backend
backend/tmp/
backend/bin/
backend/.go-cache/
.go-cache/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# Frontend
frontend-admin/node_modules/
frontend-admin/build/
frontend-admin/.pnp
frontend-admin/.pnp.js
frontend-user/node_modules/
frontend-user/build/
frontend-user/.pnp
frontend-user/.pnp.js
frontend-user/dist/

# Testing
coverage/

# IDE and OS
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# AI tool configs
.claude/

# Backup files
*.bak

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
