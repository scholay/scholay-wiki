                                          "content": "Dr. Joao Monteiro",
                                          "fontFamily": "Inter",
                                          "fontSize": 13,
                                          "fontWeight": "700"
                                        },
                                        {
                                          "type": "text",
                                          "id": "z940VT",
                                          "fill": "#444444",
                                          "content": "Chief Editor, Nature Medicine",
                                          "fontFamily": "Inter",
                                          "fontSize": 13,
                                          "fontWeight": "normal"
                                        },
                                        {
                                          "type": "text",
                                          "id": "Plsj5",
                                          "fill": "#444444",
                                          "content": "Springer Nature, London, UK",
                                          "fontFamily": "Inter",
                                          "fontSize": 13,
                                          "fontWeight": "normal"
                                        }
                                      ]
                                    },
                                    {
                                      "type": "text",
                                      "id": "SozGS",
                                      "fill": "#111111",
                                      "content": "Dear Dr. Monteiro,",
                                      "fontFamily": "Inter",
                                      "fontSize": 13,
                                      "fontWeight": "600"
                                    },
                                    {
                                      "type": "text",
                                      "id": "o6neiE",
                                      "fill": "#222222",
                                      "textGrowth": "fixed-width",
                                      "width": "fill_container",
                                      "content": "On behalf of all co-authors, we are pleased to submit our manuscript entitled \"Applications and Challenges of Artificial Intelligence in Medical Imaging\" for consideration as an Original Research article in Nature Medicine.",
                                      "lineHeight": 1.6,
                                      "fontFamily": "Inter",
                                      "fontSize": 13,
                                      "fontWeight": "normal"
                                    },
                                    {
                                      "type": "text",
                                      "id": "AIT5O",
                                      "fill": "#222222",
                                      "textGrowth": "fixed-width",
                                      "width": "fill_container",
                                      "content": "Building on a systematic review of 50 representative studies, our work proposes three actionable challenges for the field — clinical deployment, model interpretability and patient-data privacy — and provides a unified evaluation framework that we believe will be of broad interest to your readership.",
                                      "lineHeight": 1.6,
                                      "fontFamily": "Inter",
                                      "fontSize": 13,
                                      "fontWeight": "normal"
                                    },
                                    {
                                      "type": "text",
                                      "id": "oaJam",
                                      "fill": "#222222",
                                      "textGrowth": "fixed-width",
                                      "width": "fill_container",
                                      "content": "This study has not been published or submitted elsewhere. All authors have read and approved the final version of the manuscript and declare no competing interests. The work was supported by the National Natural Science Foundation of China (Grant No. ●●●●●).",
                                      "lineHeight": 1.6,
                                      "fontFamily": "Inter",
                                      "fontSize": 13,
                                      "fontWeight": "normal"
                                    },
                                    {
                                      "type": "text",
                                      "id": "bg5ve",
                                      "fill": "#222222",
                                      "textGrowth": "fixed-width",
                                      "width": "fill_container",
                                      "content": "Thank you for considering our submission. We look forward to your editorial decision.",
                                      "lineHeight": 1.6,
                                      "fontFamily": "Inter",
                                      "fontSize": 13,
                                      "fontWeight": "normal"
                                    },
                                    {
                                      "type": "frame",
                                      "id": "PR9Zr",
