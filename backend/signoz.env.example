# SigNoz Configuration
# Copy this file to .env and update with your actual values

# SigNoz Endpoint
SIGNOZ_ENDPOINT=http://198.44.187.186:4318

# Service Configuration
SERVICE_NAME=scholar-backend
ENVIRONMENT=production

# Feature Flags
ENABLE_TRACING=true
ENABLE_LOGGING=true
ENABLE_METRICS=true

# Sampling Configuration
# 1.0 = 100% sampling, 0.5 = 50% sampling, 0.1 = 10% sampling
SAMPLING_RATE=1.0

# Optional: Custom attributes
# You can add custom attributes that will be included with all telemetry data
# CUSTOM_ATTRIBUTE_REGION=us-west-2
# CUSTOM_ATTRIBUTE_VERSION=1.0.0
# CUSTOM_ATTRIBUTE_DEPLOYMENT=blue-green
