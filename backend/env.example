# ===================================
# Scholar Backend Environment Variables
# ===================================
# Copy this file to .env and update with your actual values

# ===================================
# Server Configuration
# ===================================
SERVER_PORT=8080

# ===================================
# Database Configuration
# ===================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=scholar_user
DB_PASSWORD=scholar_pass
DB_NAME=scholar

# ===================================
# Redis Configuration
# ===================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===================================
# JWT Configuration
# ===================================
JWT_SECRET=your-secret-key-change-in-production

# ===================================
# Admin Configuration
# ===================================
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=adminadmin

# ===================================
# SigNoz 日志采集配置
# ===================================
# SigNoz 采集端点地址
SIGNOZ_ENDPOINT=http://198.44.187.186:4318

# 服务名称（在 SigNoz 中显示的服务标识）
SIGNOZ_SERVICE_NAME=scholar-backend

# 环境标识（production/staging/development）
SIGNOZ_ENVIRONMENT=production

# 是否启用分布式追踪（true/false）
SIGNOZ_ENABLE_TRACING=true

# 是否启用日志采集（true/false）
SIGNOZ_ENABLE_LOGGING=true

# 是否启用指标采集（true/false）
SIGNOZ_ENABLE_METRICS=true

# 采样率（0.0-1.0）
# 1.0 = 100% 采样（记录所有请求）
# 0.5 = 50% 采样（记录一半请求）
# 0.1 = 10% 采样（记录10%请求）
# 建议：开发环境使用 1.0，生产环境根据流量调整
SIGNOZ_SAMPLING_RATE=1.0

# ===================================
# 其他第三方服务配置（根据需要添加）
# ===================================
# Alipay Configuration
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=
# ALIPAY_PUBLIC_KEY=

# WeChat Configuration
# WECHAT_APP_ID=
# WECHAT_APP_SECRET=

# Email Service Configuration
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# SMS Service Configuration
# SMS_ACCESS_KEY_ID=
# SMS_ACCESS_KEY_SECRET=
# SMS_SIGN_NAME=
# SMS_TEMPLATE_CODE=

# GitHub OAuth Configuration
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Turnstile Configuration
# TURNSTILE_SECRET_KEY=
