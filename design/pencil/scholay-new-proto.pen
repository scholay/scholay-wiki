                                            },
                                            {
                                              "type": "text",
                                              "id": "jDSJO",
                                              "name": "arXiv · 2022",
                                              "context": "p",
                                              "fill": "#777777",
                                              "textGrowth": "fixed-width",
                                              "width": "fill_container",
                                              "content": "arXiv · 2022",
                                              "lineHeight": 1.5,
