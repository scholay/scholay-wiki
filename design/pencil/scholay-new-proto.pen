                                              "name": "Rishi Bommasani, Fei-Fei Li",
                                              "context": "p",
                                              "fill": "#444444",
                                              "textGrowth": "fixed-width",
                                              "width": "fill_container",
                                              "content": "Rishi Bommasani, Fei-Fei Li",
                                              "lineHeight": 1.63,
                                              "textAlign": "center",
                                              "fontFamily": "Inter",
                                              "fontSize": 13,
                                              "fontWeight": "normal"
                                            },
                                            {
                                              "type": "frame",
