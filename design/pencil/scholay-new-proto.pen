                                              "children": [
                                                {
                                                  "type": "text",
                                                  "id": "mjt0R",
                                                  "name": "To evaluate the importance of different ",
                                                  "context": "p",
                                                  "fill": "#333333",
                                                  "textGrowth": "fixed-width-height",
                                                  "width": "fill_container",
                                                  "height": 38.5,
                                                  "content": "To evaluate the importance of different components of the Transformer, we varied our base model in different ways, measuring the change in performance on English-to-German translation.",
                                                  "lineHeight": 1.75,
                                                  "fontFamily": "Inter",
                                                  "fontSize": 11,
                                                  "fontWeight": "normal"
                                                },
                                                {
                                                  "type": "text",
                                                  "id": "hvBJl",
                                                  "name": "We trained on the standard WMT 2014 Engl",
                                                  "context": "p",
                                                  "fill": "#333333",
                                                  "content": "We trained on the standard WMT 2014 English-German dataset consisting of about 4.5 million sentence pairs.",
                                                  "lineHeight": 1.75,
                                                  "fontFamily": "Inter",
                                                  "fontSize": 11,
                                                  "fontWeight": "normal"
                                                }
