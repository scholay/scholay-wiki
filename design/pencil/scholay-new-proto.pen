                                                },
                                                {
                                                  "type": "text",
                                                  "id": "z4m5dL",
                                                  "name": "arXiv · 2022",
                                                  "context": "p",
                                                  "fill": "#777777",
                                                  "textGrowth": "fixed-width",
                                                  "width": "fill_container",
                                                  "content": "arXiv · 2022",
                                                  "lineHeight": 1.5,
                                                  "textAlign": "center",
                                                  "fontFamily": "Inter",
                                                  "fontSize": 11,
                                                  "fontWeight": "normal"
                                                }
                                              ]
                                            },
                                            {
                                              "type": "frame",
                                              "id": "y6JL4v",
                                              "name": "div",
                                              "context": "div",
                                              "width": "fill_container",
                                              "layout": "vertical",
                                              "gap": 20,
                                              "padding": [
                                                32,
                                                40
                                              ],
                                              "children": [
                                                {
                                                  "type": "frame",
                                                  "id": "YwnUG",
                                                  "name": "section",
                                                  "context": "section",
                                                  "width": "fill_container",
                                                  "height": 106,
                                                  "layout": "vertical",
                                                  "gap": 8,
                                                  "children": [
                                                    {
                                                      "type": "text",
                                                      "id": "PHoyw",
                                                      "name": "ABSTRACT",
                                                      "context": "h2",
                                                      "fill": "#555555",
                                                      "content": "ABSTRACT",
                                                      "lineHeight": 1.75,
                                                      "fontFamily": "Inter",
                                                      "fontSize": 12,
                                                      "fontWeight": "700",
                                                      "letterSpacing": 1.44
                                                    },
                                                    {
                                                      "type": "text",
                                                      "id": "r50Due",
                                                      "name": "The dominant sequence transduction model",
                                                      "context": "p",
                                                      "fill": "#333333",
                                                      "textGrowth": "fixed-width-height",
                                                      "width": "fill_container",
                                                      "height": 77,
                                                      "content": "The dominant sequence transduction models are based on complex recurrent or convolutional neural networks that include an encoder and a decoder. The best performing models also connect the encoder and decoder through an attention mechanism. We propose a new simple network architecture, the Transformer, based solely on attention mechanisms, dispensing with recurrence and convolutions entirely.",
                                                      "lineHeight": 1.75,
                                                      "fontFamily": "Inter",
                                                      "fontSize": 11,
                                                      "fontWeight": "normal"
                                                    }
                                                  ]
                                                },
                                                {
                                                  "type": "frame",
                                                  "id": "ewFzV",
                                                  "name": "section",
                                                  "context": "section",
                                                  "width": "fill_container",
                                                  "gap": 20,
                                                  "children": [
                                                    {
                                                      "type": "frame",
                                                      "id": "uGpGj",
                                                      "name": "div",
                                                      "context": "div",
                                                      "width": "fill_container",
                                                      "height": 266.25,
                                                      "layout": "vertical",
                                                      "gap": 8,
                                                      "children": [
                                                        {
                                                          "type": "text",
                                                          "id": "hN8Sj",
                                                          "name": "Experiments on two machine translation t",
                                                          "context": "p",
                                                          "fill": "#333333",
                                                          "textGrowth": "fixed-width-height",
                                                          "width": "fill_container",
                                                          "height": 77,
                                                          "content": "Experiments on two machine translation tasks show that these models are superior in quality while being more parallelizable and requiring significantly less time to train.",
                                                          "lineHeight": 1.75,
                                                          "fontFamily": "Inter",
                                                          "fontSize": 11,
                                                          "fontWeight": "normal"
                                                        },
                                                        {
                                                          "type": "text",
                                                          "id": "Mh4pi",
                                                          "name": "Our model achieves 28.4 BLEU on the WMT ",
                                                          "context": "p",
                                                          "fill": "#333333",
                                                          "textGrowth": "fixed-width-height",
                                                          "width": "fill_container",
                                                          "height": 77,
                                                          "content": "Our model achieves 28.4 BLEU on the WMT 2014 English-to-German translation task, improving over the existing best results, including ensembles, by over 2 BLEU.",
                                                          "lineHeight": 1.75,
                                                          "fontFamily": "Inter",
                                                          "fontSize": 11,
                                                          "fontWeight": "normal"
                                                        },
                                                        {
                                                          "type": "text",
                                                          "id": "v66Js6",
                                                          "name": "On the WMT 2014 English-to-French transl",
                                                          "context": "p",
                                                          "fill": "#333333",
                                                          "textGrowth": "fixed-width-height",
                                                          "width": "fill_container",
                                                          "height": 77,
                                                          "content": "On the WMT 2014 English-to-French translation task, our model establishes a new single-model state-of-the-art BLEU score of 41.8 after training for 3.5 days on eight GPUs.",
                                                          "lineHeight": 1.75,
                                                          "fontFamily": "Inter",
                                                          "fontSize": 11,
                                                          "fontWeight": "normal"
                                                        }
                                                      ]
                                                    },
                                                    {
                                                      "type": "frame",
                                                      "id": "ug30a",
                                                      "name": "div",
                                                      "context": "div",
                                                      "width": "fill_container",
                                                      "height": 266.25,
                                                      "layout": "vertical",
                                                      "gap": 8,
                                                      "children": [
                                                        {
                                                          "type": "text",
                                                          "id": "XeHjj",
                                                          "name": "We show that the Transformer generalizes",
                                                          "context": "p",
                                                          "fill": "#333333",
                                                          "textGrowth": "fixed-width-height",
                                                          "width": "fill_container",
                                                          "height": 77,
                                                          "content": "We show that the Transformer generalizes well to other tasks by applying it successfully to English constituency parsing with large amounts of training data.",
                                                          "lineHeight": 1.75,
                                                          "fontFamily": "Inter",
                                                          "fontSize": 11,
                                                          "fontWeight": "normal"
                                                        },
                                                        {
                                                          "type": "text",
                                                          "id": "LPC56",
                                                          "name": "Attention mechanisms have become an inte",
                                                          "context": "p",
                                                          "fill": "#333333",
                                                          "textGrowth": "fixed-width-height",
                                                          "width": "fill_container",
                                                          "height": 96.25,
                                                          "content": "Attention mechanisms have become an integral part of compelling sequence modeling and transduction models in various tasks, allowing modeling of dependencies without regard to their distance in the input or output sequences.",
                                                          "lineHeight": 1.75,
                                                          "fontFamily": "Inter",
                                                          "fontSize": 11,
                                                          "fontWeight": "normal"
                                                        },
                                                        {
                                                          "type": "text",
                                                          "id": "mkIXl",
                                                          "name": "Self-attention, sometimes called intra-a",
                                                          "context": "p",
                                                          "fill": "#333333",
                                                          "textGrowth": "fixed-width-height",
                                                          "width": "fill_container",
                                                          "height": 77,
                                                          "content": "Self-attention, sometimes called intra-attention, is an attention mechanism relating different positions of a single sequence in order to compute a representation of the sequence.",
                                                          "lineHeight": 1.75,
                                                          "fontFamily": "Inter",
                                                          "fontSize": 11,
                                                          "fontWeight": "normal"
                                                        }
                                                      ]
                                                    }
                                                  ]
                                                },
