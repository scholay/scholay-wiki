                                              "content": "Rishi Bommasani, Fei-Fei Li",
                                              "lineHeight": 1.63,
                                              "textAlign": "center",
                                              "fontFamily": "Inter",
                                              "fontSize": 13,
                                              "fontWeight": "normal"
                                            },
