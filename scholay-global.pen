                              "gap": 8,
                              "padding": [
                                0,
                                0,
                                16,
                                0
                              ],
                              "children": [
                                {
                                  "type": "text",
                                  "id": "rgq8a",
                                  "fill": "#0F0F0F",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "Deep Learning for Medical Image Segmentation: A Comprehensive Survey",
                                  "lineHeight": 1.35,
                                  "fontFamily": "Inter",
                                  "fontSize": 20,
                                  "fontWeight": "700"
                                },
                                {
                                  "type": "frame",
                                  "id": "FC5ha",
                                  "name": "phM",
                                  "gap": 8,
                                  "alignItems": "center",
                                  "children": [
                                    {
                                      "type": "text",
                                      "id": "v91GQ",
                                      "fill": "#555555",
                                      "content": "Z. Wang, H. Liu, J. Chen, et al.",
                                      "fontFamily": "Inter",
                                      "fontSize": 11,
                                      "fontWeight": "normal"
                                    },
                                    {
                                      "type": "text",
                                      "id": "kdvjG",
                                      "fill": "#BBBBBB",
                                      "content": "·",
                                      "fontFamily": "Inter",
                                      "fontSize": 11,
                                      "fontWeight": "normal"
                                    },
                                    {
                                      "type": "text",
                                      "id": "PC5C5",
                                      "fill": "#555555",
                                      "content": "Medical Image Analysis 84 (2023) 102680",
                                      "fontFamily": "Inter",
                                      "fontSize": 11,
                                      "fontWeight": "normal",
                                      "fontStyle": "italic"
                                    }
                                  ]
                                }
                              ]
                            },
                            {
                              "type": "frame",
                              "id": "TCNXJ",
                              "name": "absHead",
                              "gap": 6,
                              "padding": [
                                8,
                                0,
                                2,
                                0
                              ],
                              "alignItems": "center",
                              "children": [
                                {
                                  "type": "text",
                                  "id": "Qgz1b",
                                  "fill": "#111111",
                                  "content": "Abstract",
                                  "fontFamily": "Inter",
                                  "fontSize": 12,
                                  "fontWeight": "700",
                                  "letterSpacing": 1
                                }
                              ]
                            },
                            {
                              "type": "text",
                              "id": "V2s49U",
                              "fill": "#2A2A2A",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Medical image segmentation plays a pivotal role in modern computer-aided diagnosis, treatment planning, and quantitative analysis. The recent surge of deep learning techniques — particularly fully-convolutional and transformer-based architectures — has redefined what is achievable in pixel-level recognition of anatomical structures and pathological regions. In this survey we provide a comprehensive overview of the field, covering more than 250 representative works published between 2015 and 2023.",
                              "lineHeight": 1.7,
                              "fontFamily": "Inter",
                              "fontSize": 12.5,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "frame",
                              "id": "Yu011",
                              "name": "sec1Head",
                              "gap": 8,
                              "padding": [
                                16,
                                0,
                                2,
                                0
                              ],
                              "alignItems": "end",
                              "children": [
                                {
                                  "type": "text",
                                  "id": "becK7",
                                  "fill": "#0F0F0F",
                                  "content": "1.",
                                  "fontFamily": "Inter",
                                  "fontSize": 15,
                                  "fontWeight": "700"
                                },
                                {
                                  "type": "text",
                                  "id": "gi1f0",
                                  "fill": "#0F0F0F",
                                  "content": "Introduction",
                                  "fontFamily": "Inter",
                                  "fontSize": 15,
                                  "fontWeight": "700"
                                }
                              ]
                            },
                            {
                              "type": "text",
                              "id": "gUMQE",
                              "fill": "#2A2A2A",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "Image segmentation is one of the most fundamental yet challenging problems in medical image analysis. Unlike classification or detection, segmentation requires dense, per-pixel reasoning about anatomy, which is often ambiguous due to low contrast, motion artifacts, and inter-subject variability. Traditional pipelines relied on hand-crafted features combined with statistical shape models, but these approaches struggled to generalize across modalities and clinical sites.",
                              "lineHeight": 1.75,
                              "fontFamily": "Inter",
                              "fontSize": 12.5,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "frame",
                              "id": "I9mC2P",
                              "name": "highlightRow",
                              "width": "fill_container",
                              "gap": 8,
                              "padding": [
                                2,
                                0
                              ],
                              "children": [
                                {
                                  "type": "frame",
                                  "id": "cG9fm",
                                  "name": "highlight",
                                  "width": "fill_container",
                                  "fill": "#FFF1A8",
                                  "stroke": "#E9C72A",
                                  "strokeWidth": {
                                    "bottom": 2
                                  },
                                  "strokeAlignment": "inner",
                                  "padding": [
                                    6,
                                    8
                                  ],
                                  "children": [
                                    {
                                      "type": "text",
                                      "id": "p0bmC",
                                      "fill": "#1F1A00",
                                      "textGrowth": "fixed-width",
                                      "width": "fill_container",
                                      "content": "Since the introduction of U-Net in 2015, encoder-decoder architectures with skip connections have become the de-facto baseline; more recent transformer-based variants such as TransUNet and Swin-Unet achieve consistent gains on multi-organ benchmarks, but the trade-offs between data efficiency and modeling capacity remain poorly understood.",
                                      "lineHeight": 1.7,
                                      "fontFamily": "Inter",
                                      "fontSize": 12.5,
                                      "fontWeight": "500"
                                    }
                                  ]
                                },
                                {
                                  "type": "frame",
                                  "id": "wdXWl",
                                  "name": "askBtn",
                                  "fill": "#111111",
                                  "cornerRadius": 18,
                                  "effect": {
                                    "type": "shadow",
                                    "shadowType": "outer",
                                    "color": "#0000002E",
                                    "offset": {
                                      "x": 0,
                                      "y": 3
                                    },
                                    "blur": 10
                                  },
                                  "gap": 6,
                                  "padding": [
                                    7,
                                    12
                                  ],
                                  "alignItems": "center",
                                  "children": [
                                    {
                                      "type": "icon",
                                      "id": "Ys34y",
                                      "width": 13,
                                      "height": 13,
                                      "icon": "sparkles",
                                      "library": "lucide",
                                      "fill": "#FFD24D"
                                    },
                                    {
                                      "type": "text",
                                      "id": "iHewy",
                                      "fill": "#FFFFFF",
                                      "content": "问这句",
                                      "fontFamily": "Inter",
                                      "fontSize": 11,
                                      "fontWeight": "600"
                                    }
                                  ]
                                }
                              ]
                            },
                            {
                              "type": "text",
                              "id": "mqeQ7",
                              "fill": "#2A2A2A",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "In this section, we briefly review the historical context of medical image segmentation, define the taxonomy of approaches used throughout the survey, and articulate the open questions that frame our analysis. We pay particular attention to architectural inductive biases, supervision regimes, and the role of large pre-trained vision backbones in low-label clinical scenarios.",
                              "lineHeight": 1.75,
                              "fontFamily": "Inter",
                              "fontSize": 12.5,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "frame",
                              "id": "ReisS",
                              "name": "sec2Head",
                              "gap": 8,
                              "padding": [
                                12,
                                0,
                                2,
                                0
                              ],
                              "alignItems": "end",
                              "children": [
                                {
                                  "type": "text",
                                  "id": "so2hB",
                                  "fill": "#0F0F0F",
                                  "content": "1.1",
                                  "fontFamily": "Inter",
                                  "fontSize": 13,
                                  "fontWeight": "700"
                                },
                                {
                                  "type": "text",
                                  "id": "rSo72",
                                  "fill": "#0F0F0F",
                                  "content": "Scope and contributions",
                                  "fontFamily": "Inter",
                                  "fontSize": 13,
                                  "fontWeight": "700"
                                }
                              ]
                            },
                            {
                              "type": "text",
                              "id": "TdKm9",
                              "fill": "#2A2A2A",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "We restrict our scope to 2D and 3D semantic segmentation of medical images, including CT, MRI, ultrasound, X-ray, and digital pathology. Instance and panoptic segmentation in non-medical domains are referenced only when methods transferred meaningfully to clinical workflows.",
                              "lineHeight": 1.75,
                              "fontFamily": "Inter",
                              "fontSize": 12.5,
                              "fontWeight": "normal"
                            }
                          ]
                        }
                      ]
                    }
