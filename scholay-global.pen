                                                  "content": "可直接贴入 Limitations 段落",
                                                  "fontFamily": "Inter",
                                                  "fontSize": 10,
                                                  "fontWeight": "700"
                                                }
                                              ]
                                            },
                                            {
                                              "type": "text",
                                              "id": "ybsyh",
                                              "fill": "#1B3A6B",
                                              "textGrowth": "fixed-width",
                                              "width": "fill_container",
                                              "content": "\"现有 VQE 研究对 active space 的选择依赖 AVAS 等启发式投影，但其在过渡金属氧化物中对 d-p 杂化敏感、阈值跨实现不一致，使得同体系结果难以跨工作流复现。\"",
                                              "lineHeight": 1.65,
                                              "fontFamily": "Inter",
                                              "fontSize": 12,
                                              "fontWeight": "500"
                                            }
                                          ]
