                              "fontWeight": "700"
                            },
                            {
                              "type": "text",
                              "id": "EoDwN",
                              "fill": "#444444",
                              "textGrowth": "fixed-width",
                              "width": "fill_container",
                              "content": "IBM SPSS Statistics 是一款历史悠久的统计分析软件。从 1968 年起，它是社会科学、心理学、医学、市场研究等领域研究者的首选。无需写代码即可完成方差分析、回归、因子分析、聚类等复杂统计建模。",
                              "lineHeight": 1.7,
                              "fontFamily": "Inter",
                              "fontSize": 13,
                              "fontWeight": "normal"
                            },
                            {
                              "type": "text",
                              "id": "Z63oTW",
                              "fill": "#444444",
