                                42,
                                48
                              ],
                              "children": [
                                {
                                  "type": "text",
                                  "id": "NBg8L",
                                  "fill": "#111111",
                                  "content": "4. Results",
                                  "fontFamily": "Playfair Display",
                                  "fontSize": 16,
                                  "fontWeight": "700"
                                },
                                {
                                  "type": "text",
                                  "id": "qHx9d",
                                  "fill": "#222222",
                                  "content": "4.1 Cross-dataset model comparison",
                                  "fontFamily": "Inter",
                                  "fontSize": 11,
                                  "fontWeight": "700"
                                },
                                {
                                  "type": "text",
                                  "id": "pigzA",
                                  "fill": "#444444",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "We benchmarked 12 representative deep-learning architectures across three publicly available medical-imaging datasets (CheXpert, MIMIC-CXR and ISIC-2024). Each model was trained for 50 epochs with the same data-augmentation pipeline and evaluated using AUC, F1 and calibration error.",
                                  "lineHeight": 1.7,
                                  "fontFamily": "Inter",
                                  "fontSize": 10,
                                  "fontWeight": "normal"
