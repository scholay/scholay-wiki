                                          "fill": "#222222",
                                          "textGrowth": "fixed-width",
                                          "width": "fill_container",
                                          "content": "We introduce a Clinical Deployment Feasibility Index (CDFI) that jointly considers throughput, false-negative cost, on-prem latency, and integration burden, providing a single-number guidance for hospital procurement committees.",
                                          "lineHeight": 1.6,
                                          "fontFamily": "Inter",
                                          "fontSize": 12,
                                          "fontWeight": "normal",
                                          "fontStyle": "italic"
