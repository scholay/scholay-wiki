# ============================================================
# Paper Reviewer Agent — 环境变量模板
# 复制为 .env 并填入实际值: cp .env.example .env
# ============================================================

# ----- 上游模型 (Anthropic Messages 协议,目标: DeepSeek 原生 Anthropic 端点) -----
# 例: https://api.deepseek.com/anthropic
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=
ANTHROPIC_DEFAULT_HAIKU_MODEL=
ANTHROPIC_DEFAULT_SONNET_MODEL=
ANTHROPIC_DEFAULT_OPUS_MODEL=

# ----- 服务端绑定 (docker 内部) -----
SERVER_HOST=0.0.0.0
SERVER_PORT=3456

# ----- 通用 -----
API_TIMEOUT_MS=600000
DISABLE_TELEMETRY=1
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

# ----- 服务端鉴权 (内网部署可留空;非 127.0.0.1 监听时必填) -----
ANTHROPIC_API_KEY=

# ----- 预装 MCP server: Minicod 论文/期刊检索 (启动时展开,改值需重启 agent) -----
MINICOD_API_KEY=
