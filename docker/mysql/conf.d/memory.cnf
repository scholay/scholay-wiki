# ============================================================================
# Scholay学术 V1.0
# MySQL 内存优化配置
# Copyright (c) 2025 成都恩特罐罐文化科技有限公司
# ============================================================================
#
# 容器内存上限: 2G (见 docker-compose.yml)
# 内存预算（典型负载，约 100 个并发连接）:
#   InnoDB buffer pool   : 900M
#   InnoDB log buffer    :  64M
#   每连接缓冲 ~10M × 100: 1000M（峰值，多数连接远低于此）
#   线程/系统/临时表/字典:  ~200M
#   合计峰值              ≈ 2.1G（接近上限，故 max_connections 收敛到 100）
# ============================================================================

[mysqld]
# InnoDB 缓冲池配置（容器内存的 ~45%，给连接 buffer 和系统留余量）
innodb_buffer_pool_size = 900M
innodb_buffer_pool_instances = 4

# InnoDB 日志配置
innodb_log_file_size = 256M
innodb_log_buffer_size = 64M
innodb_flush_log_at_trx_commit = 2

# 连接相关（从 200 降到 100 防 OOM；后端单实例 MaxOpenConns 已配 200 需同步下调）
max_connections = 100
max_allowed_packet = 16M
thread_cache_size = 50
table_open_cache = 2000
table_definition_cache = 1500

# 临时表配置
tmp_table_size = 32M
max_heap_table_size = 32M

# 排序和读取缓冲区（每连接独立分配，减小以适配更高连接密度）
sort_buffer_size = 1M
read_buffer_size = 1M
read_rnd_buffer_size = 2M
join_buffer_size = 2M

# 批量插入缓冲
bulk_insert_buffer_size = 32M

# 键缓冲（MyISAM，主要用 InnoDB，仅保留基本配置）
key_buffer_size = 16M

# 其他性能优化
innodb_file_per_table = 1
innodb_stats_on_metadata = 0
innodb_random_read_ahead = 0

# 连接超时
wait_timeout = 28800
interactive_timeout = 28800

# 慢查询日志:此处不启用。
# 历史上这里写 slow_query_log=1 + 文件到 /var/lib/mysql/slow.log,但 docker-compose 的
# `command:` 传了 `--slow-query-log=0`(命令行覆盖 cnf),所以实际一直是关的 —— 那几行是
# 误导性死配置(性能审计 infra)。FILE 模式落到无轮转的挂载卷会无限增长, 故刻意保持关闭。
# 若需观测慢查询, 改在 command 用 `--slow-query-log=1 --log-output=TABLE`(写 mysql.slow_log
# 表, 无磁盘无限增长问题), 不要在这里用 FILE 模式。
long_query_time = 2
log_queries_not_using_indexes = 0

# ── 时区 ─────────────────────────────────────────────────────────────────────
# 跟随容器系统时区,不自定义偏移。SYSTEM = 容器的 /etc/localtime,由 docker 层挂仓库自带的
# docker/tz/Asia-Shanghai(IANA TZif)钉死为北京,故宿主时区任意都解析成 +08:00
# (实测 system_time_zone=CST → SET time_zone=SYSTEM 后 NOW() 与 +08:00 完全一致)。
# 影响 NOW()/CURDATE()/CURRENT_TIMESTAMP 默认值与 DATE_FORMAT 日聚合,与 app 侧 time.Local 同区。
# 注:2026-07-15 曾有「宿主 UTC 时全线漂 UTC、北京 0 点不重置」事故 —— 根因是当时未挂仓库
# tzfile,SYSTEM 跟到了裸宿主;现所有容器都挂 /etc/localtime=北京,SYSTEM 即北京。
# dev/prod compose 都挂本目录,一处配置两侧生效。
default-time-zone = SYSTEM
