#!/usr/bin/env bash
# ============================================================================
# pre-push —— 设计系统护栏的自动执行点。
#
# 🔴 生效前提(每台机器执行一次,否则本文件永远不会被调用):
#        git config core.hooksPath .githooks
#     或  scripts/install-git-hooks.sh
#     .git/hooks/ 不进版本库 —— 把钩子放那儿 = 只有你自己有 = 等于没有。
#     这也是本目录存在的全部理由:钩子必须**跟着仓库走**。
#
# 【为什么是 pre-push,不是 pre-commit】
#   · 护栏读的是**工作区**文件,不是 index。pre-commit 时工作区常有未 stage 的改动,
#     结论与「这次提交的内容」对不上 —— 既能假绿也能假红。要对齐 index 就得 stash,
#     而 stash 在本仓库(常年一堆未提交改动)是会丢东西的操作,不做。
#     push 时工作区与将要推出去的内容基本一致,口径最诚实。
#   · 频率。护栏一次约 3~4s。挂 pre-commit 上,每个 WIP commit 都付这个钱,
#     两天就会长出 `--no-verify` 的肌肉记忆 —— 那时护栏比不装还糟(它还在,但没人跑,
#     而所有人以为它在跑)。push 罕见得多,3s 没人想绕。
#   · push 是「代码离开本机」的边界,是最后一道属于自己的闸。
#
# 【绕过】
#   SKIP_DESIGN_GUARD=1 git push   → 放行,但**留痕**:记一行到 .git/design-guard-bypass.log
#   git push --no-verify           → git 层面根本不调用本文件,**无痕**。别用这个。
#
# 本钩子只跑设计护栏。要加别的闸(如 scripts/check-backend-conventions.sh),
# 在下面照着加一段,并同样保留「exit 2 = 没能检查 ≠ 通过」的三档语义。
# ============================================================================
set -uo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
GITDIR="$(git rev-parse --git-dir 2>/dev/null)" || exit 0
BYPASS_LOG="$GITDIR/design-guard-bypass.log"
CHECK="$ROOT/scripts/check-design-system.sh"

banner() {
  echo ""
  echo "════════════════════════════════════════════════════════════════════════════"
  while [ "$#" -gt 0 ]; do echo " $1"; shift; done
  echo "════════════════════════════════════════════════════════════════════════════"
  echo ""
}

# 留痕:绕过/跑不了都记一行。谁在什么时候把哪个 commit 推出去而没过闸,事后查得到。
record() {
  printf '%s\t%s\t%s\t%s\t%s\n' \
    "$(date '+%Y-%m-%d %H:%M:%S')" \
    "$(git config user.email 2>/dev/null || echo '?')" \
    "$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')" \
    "$(git rev-parse --short HEAD 2>/dev/null || echo '?')" \
    "$1" >>"$BYPASS_LOG" 2>/dev/null || true
}

if [ -n "${SKIP_DESIGN_GUARD:-}" ]; then
  record "bypass: SKIP_DESIGN_GUARD=1"
  banner "⚠️  设计护栏被显式绕过(SKIP_DESIGN_GUARD=1)—— 本次 push 未经校验。" \
          "   已记录到 $BYPASS_LOG"
  exit 0
fi

if [ ! -x "$CHECK" ]; then
  record "not-run: $CHECK 缺失或不可执行"
  banner "⚠️  设计护栏没跑:找不到可执行的 scripts/check-design-system.sh。" \
          "   放行,但这不等于通过。已记录到 $BYPASS_LOG"
  exit 0
fi

echo "[pre-push] 设计系统护栏…"
"$CHECK"
rc=$?

case "$rc" in
  0)
    exit 0
    ;;
  2)
    # 环境未就绪(缺 node_modules / 缺兄弟包)。这不是设计违规,阻断就是误报 ——
    # 而误报的下场从来是规则被人放宽。所以放行,但吵,并且留痕。
    record "not-run: 环境未就绪 (check-design-system.sh exit 2)"
    banner "⚠️  设计护栏本次【没有跑】(环境未就绪,原因见上)。" \
            "   push 放行,但绿灯不存在 —— 别把这次当成校验通过。" \
            "   已记录到 $BYPASS_LOG"
    exit 0
    ;;
  *)
    banner "✗ 设计系统护栏失败,push 已阻止。" \
            "   修掉上面列出的违规再推。" \
            "   确有必要绕过(会留痕):  SKIP_DESIGN_GUARD=1 git push"
    exit 1
    ;;
esac
