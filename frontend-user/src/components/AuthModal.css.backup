/* 弹窗遮罩层 */
.auth-modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  animation: fadeIn 0.2s ease;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

/* 弹窗主体 */
.auth-modal-content {
  background: white;
  border-radius: 12px;
  width: 90%;
  max-width: 450px;
  max-height: 90vh;
  overflow-y: auto;
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
  position: relative;
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from {
    transform: translateY(50px);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

/* 关闭按钮 */
.auth-modal-close {
  position: absolute;
  top: 1rem;
  right: 1rem;
  background: none;
  border: none;
  font-size: 2rem;
  color: #94a3b8;
  cursor: pointer;
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: all 0.2s;
}

.auth-modal-close:hover {
  background: #f1f5f9;
  color: #475569;
}

/* 头部 */
.auth-modal-header {
  padding: 2rem 2rem 1rem;
  border-bottom: 1px solid #e2e8f0;
}

.auth-modal-header h2 {
  margin: 0;
  font-size: 1.5rem;
  color: #1e293b;
  font-weight: 600;
}

/* 主体内容 */
.auth-modal-body {
  padding: 2rem;
}

/* 邮箱显示 */
.email-display {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.75rem 1rem;
  background: #f8fafc;
  border-radius: 8px;
  margin-bottom: 1.5rem;
}

.email-display span {
  color: #475569;
  font-size: 0.9375rem;
  font-weight: 500;
}

/* 表单组 */
.form-group {
  margin-bottom: 1.25rem;
}

.form-group label {
  display: block;
  margin-bottom: 0.5rem;
  color: #475569;
  font-size: 0.875rem;
  font-weight: 500;
}

.form-group input[type="email"],
.form-group input[type="password"],
.form-group input[type="text"] {
  width: 100%;
  padding: 0.75rem 1rem;
  border: 2px solid #e2e8f0;
  border-radius: 8px;
  font-size: 0.9375rem;
  transition: all 0.2s;
  box-sizing: border-box;
}

.form-group input:focus {
  outline: none;
  border-color: #667eea;
  box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
}

/* 验证码输入组 */
.code-input-group {
  display: flex;
  gap: 0.75rem;
}

.code-input-group input {
  flex: 1;
}

.code-input-group .btn-secondary {
  white-space: nowrap;
  min-width: 120px;
}

/* 按钮样式 */
.btn-primary,
.btn-secondary,
.btn-text {
  padding: 0.75rem 1.5rem;
  border-radius: 8px;
  font-size: 0.9375rem;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s;
  border: none;
  width: 100%;
}

.btn-primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
}

.btn-primary:hover:not(:disabled) {
  transform: translateY(-2px);
  box-shadow: 0 6px 16px rgba(102, 126, 234, 0.4);
}

.btn-primary:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.btn-secondary {
  background: #f1f5f9;
  color: #475569;
  border: 1px solid #e2e8f0;
  width: auto;
}

.btn-secondary:hover:not(:disabled) {
  background: #e2e8f0;
}

.btn-secondary:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.btn-text {
  background: none;
  color: #667eea;
  padding: 0.25rem 0.5rem;
  width: auto;
  font-size: 0.875rem;
}

.btn-text:hover {
  text-decoration: underline;
}

.btn-link {
  background: none;
  border: none;
  color: #667eea;
  cursor: pointer;
  padding: 0;
  font-size: inherit;
  text-decoration: none;
}

.btn-link:hover {
  text-decoration: underline;
}

/* 错误提示 */
.error-message {
  padding: 0.75rem 1rem;
  background: #fee2e2;
  color: #dc2626;
  border-radius: 8px;
  font-size: 0.875rem;
  margin-bottom: 1rem;
  border-left: 3px solid #dc2626;
}

/* 隐私协议复选框 */
.policy-checkbox {
  margin: 1.5rem 0;
}

.policy-checkbox label {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  color: #64748b;
  font-size: 0.875rem;
  cursor: pointer;
}

.policy-checkbox input[type="checkbox"] {
  width: 18px;
  height: 18px;
  cursor: pointer;
  accent-color: #667eea;
}

/* 隐私协议弹窗 */
.policy-modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1001;
}

.policy-modal-content {
  background: white;
  border-radius: 12px;
  width: 90%;
  max-width: 600px;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
}

.policy-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1.5rem 2rem;
  border-bottom: 1px solid #e2e8f0;
}

.policy-header h3 {
  margin: 0;
  font-size: 1.25rem;
  color: #1e293b;
}

.policy-header button {
  background: none;
  border: none;
  font-size: 2rem;
  color: #94a3b8;
  cursor: pointer;
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: all 0.2s;
}

.policy-header button:hover {
  background: #f1f5f9;
  color: #475569;
}

.policy-body {
  flex: 1;
  overflow-y: auto;
  padding: 2rem;
}

.policy-body pre {
  white-space: pre-wrap;
  word-wrap: break-word;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', sans-serif;
  font-size: 0.875rem;
  line-height: 1.6;
  color: #475569;
  margin: 0;
}

.policy-footer {
  padding: 1.5rem 2rem;
  border-top: 1px solid #e2e8f0;
}

/* 响应式设计 */
@media (max-width: 480px) {
  .auth-modal-content {
    width: 95%;
    max-width: none;
  }

  .auth-modal-header {
    padding: 1.5rem 1.5rem 1rem;
  }

  .auth-modal-header h2 {
    font-size: 1.25rem;
  }

  .auth-modal-body {
    padding: 1.5rem;
  }

  .code-input-group {
    flex-direction: column;
  }

  .code-input-group .btn-secondary {
    width: 100%;
  }

  .policy-modal-content {
    width: 95%;
  }

  .policy-header,
  .policy-body,
  .policy-footer {
    padding: 1.25rem 1.5rem;
  }
}
