# ============================================================================
# frontend-user build-time env (Vite, VITE_ 前缀必须)
#
# 这些值在 `vite build` 时被替换进 bundle,运行时不可改。
# 生产/容器部署走根 docker-compose.yml 的 build args(从根 .env fan-out);
# 本文件只用于本机 `npm run dev`。
#
# 注:站点名/域名(SITE_NAME/SITE_URL)前端改为运行时从后端 API 取,
#     不再需要 VITE_SITE_URL / VITE_SITE_NAME build arg;umami website_id 也运行时 fetch。
# ============================================================================

# 本机 dev 一般留空 → 走 vite proxy 到 http://localhost:5411/api
VITE_API_BASE_URL=

# 智能写作(Prism)「即将推出」门:'true' = 入口角标 + /prism 页面蒙层。
# 本机 dev 不设(留空/删除)→ 放行真实 Prism。对应根 .env 的 PRISM_COMING_SOON。
VITE_PRISM_COMING_SOON=
