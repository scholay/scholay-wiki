# ============================================================================
# frontend-user build-time env (Vite, VITE_ 前缀必须)
#
# 这些值在 `vite build` 时被替换进 bundle,运行时不可改。
# 生产部署走根 docker-compose.yml 的 build args,从根 `.env` fan-out 过来 ——
# 本文件只是开发本机 `npm run dev` 时用。
#
# (旧版 CRA 源已归档到 ../frontend-user-old/,不再构建。)
#
# 字段来源:根 .env 的同名变量 (除了 VITE_ 前缀):
#   VITE_SITE_URL          ← SITE_URL
#   VITE_SITE_NAME         ← SITE_NAME
# (umami tracker website_id 现在是运行时 fetch /api/v1/public/umami-config 拿,
#  不再需要 VITE_UMAMI_WEBSITE_ID build arg)
# ============================================================================

# 本机 dev 一般留空走 vite proxy → http://localhost:5411/api
VITE_API_BASE_URL=

# 品牌字段 (LandingFooter / RouteSEO 等都读)
VITE_SITE_URL=https://www.scholay.com
VITE_SITE_NAME=Scholay

