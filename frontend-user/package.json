{
  "name": "scholar-frontend-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-pdf-cmaps.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-pdf-cmaps.mjs && npm run test:design",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/strip-katex-legacy-fonts.mjs && node scripts/precompress-assets.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest",
    "fonts:sync": "node scripts/sync-noto-serif-sc.mjs",
    "test:performance": "vitest run tests/dependency-contract.test.ts tests/web-vitals-boundary.test.ts tests/bundle-boundaries.test.ts",
    "bundle:report": "node scripts/bundle-budget.mjs --report",
    "bundle:check": "node scripts/bundle-budget.mjs --check",
    "build:analyze": "npm run build -- --manifest && npm run bundle:report",
    "ci:bundle": "npm run test:performance && npm run build -- --manifest && npm run bundle:check",
    "test:contract": "vitest run --dir tests/contract",
    "test:design": "node scripts/design-guard.mjs tests/design-system-guard.test.ts tests/design-tokens-compiled.test.ts tests/font-assets.test.ts tests/sidebar-design-contract.test.tsx tests/dependency-contract.test.ts tests/web-vitals-boundary.test.ts tests/bundle-boundaries.test.ts"
  },
