.feed {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg);
}

/* 顶栏(对标 Web FeedTopTabs):筛选 | 居中 tabs | 搜索 */
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 100rpx;
  padding: 0 28rpx;
  background: var(--card);
}
.top-ic {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.top-ic .svg-ic {
  width: 40rpx;
  height: 40rpx;
}
.top-ic:active {
  opacity: 0.5;
}
.tabs {
  flex: 1;
  display: flex;
  justify-content: center;
  gap: 48rpx;
}
.tab {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: var(--fs-body);
  color: var(--text-faint);
  padding-bottom: 8rpx;
}
.tab.on {
  color: var(--text);
  font-size: 34rpx;
  font-weight: 600;
}
.tab.on::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  border-radius: var(--r-pill);
  background: var(--red);
}

/* swiper 占满剩余高度(减去顶栏 100 + tabbar 100 + 安全区) */
.swiper {
  flex: 1;
  height: calc(100vh - 100rpx - 100rpx - env(safe-area-inset-bottom));
}

.state {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  color: var(--text-weak);
  font-size: 28rpx;
}
.state.error {
  color: var(--red);
}

/* 卡片(整屏) */
.card {
  box-sizing: border-box;
  height: 100%;
  padding: 40rpx 40rpx 60rpx;
  display: flex;
  flex-direction: column;
  background: var(--card);
}
.ident {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.cover {
  width: 56rpx;
  height: 56rpx;
  border-radius: 10rpx;
  color: var(--on-brand);
  font-size: var(--fs-body);
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.meta {
  color: var(--text-weak);
  font-size: 26rpx;
  flex: 1;
}
.fav {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.fav .svg-ic {
  width: 44rpx;
  height: 44rpx;
}
.fav:active {
  opacity: 0.5;
}
.title {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.35;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}
.badges {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}
.badge {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  background: var(--bg);
  color: var(--text-weak);
}
.badge.oa {
  background: var(--green-soft);
  color: var(--green);
}
.badge.if,
.badge.jcr {
  background: var(--green-soft);
  color: var(--green);
}
.badge.warn {
  background: var(--red-soft);
  color: var(--red);
}
.metrics {
  display: flex;
  margin-top: 28rpx;
  gap: 16rpx;
}
.metric {
  flex: 1;
  background: var(--bg);
  border-radius: 12rpx;
  padding: 16rpx 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.mv {
  font-size: var(--fs-body);
  font-weight: 700;
}
.ml {
  font-size: 22rpx;
  color: var(--text-weak);
}
.abstract {
  margin-top: 28rpx;
  font-size: var(--fs-body);
  line-height: 1.6;
  color: var(--text);
  flex: 1;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 8;
  overflow: hidden;
}
.authors {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: var(--text-weak);
}

/* 情报卡 */
.news-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.news-section {
  color: var(--red);
  font-size: 26rpx;
  font-weight: 600;
}
.news-featured {
  background: var(--red);
  color: var(--on-brand);
  font-size: 22rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
}
.news-time {
  margin-left: auto;
  color: var(--text-weak);
  font-size: 24rpx;
}
.news-cover {
  width: 100%;
  height: 320rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  background: var(--bg);
}
.news-summary {
  margin-top: 20rpx;
  font-size: var(--fs-body);
  line-height: 1.6;
  color: var(--text);
  flex: 1;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 10;
  overflow: hidden;
}
/* 有封面时空间更紧:8 行封顶,防新字号下第 9 行被 flex 盒底裁半(破版审查确认) */
.news-summary.tight {
  -webkit-line-clamp: 8;
}
.news-meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 20rpx;
  font-size: 24rpx;
  color: var(--text-weak);
}
.news-heat {
  color: var(--red);
}
.news-surge {
  color: var(--red);
  font-weight: 600;
}
