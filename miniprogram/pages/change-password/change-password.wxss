.pe {
  padding: 32rpx;
}
.field {
  background: var(--card);
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
}
.label {
  display: block;
  font-size: 26rpx;
  color: var(--text-weak);
  margin-bottom: 12rpx;
}
.input {
  font-size: var(--fs-body);
  height: 56rpx;
}
.save {
  margin-top: 20rpx;
  background: var(--red);
  color: var(--on-brand);
  border-radius: 16rpx;
  font-size: var(--fs-body);
  line-height: 88rpx;
}
.tip {
  display: block;
  margin-top: 24rpx;
  color: var(--text-weak);
  font-size: 24rpx;
  line-height: 1.6;
}
