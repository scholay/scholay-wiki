.pe {
  padding: 32rpx;
}
.field {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
}
.label {
  display: block;
  font-size: 26rpx;
  color: var(--text-weak);
  margin-bottom: 12rpx;
}
.input {
  font-size: 30rpx;
  height: 56rpx;
}
.save {
  margin-top: 20rpx;
  background: #cc2222;
  color: #fff;
  border-radius: 16rpx;
  font-size: 30rpx;
  line-height: 88rpx;
}
.tip {
  display: block;
  margin-top: 24rpx;
  color: var(--text-weak);
  font-size: 24rpx;
  line-height: 1.6;
}
