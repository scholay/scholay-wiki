<view class="page pe" capture-bind:touchstart="onUserActivity">
  <view class="field">
    <text class="label">当前密码</text>
    <input class="input" password value="{{current}}" bindinput="onCur" placeholder="输入当前密码" />
  </view>
  <view class="field">
    <text class="label">新密码</text>
    <input class="input" password value="{{next}}" bindinput="onNext" placeholder="至少 8 位" />
  </view>
  <view class="field">
    <text class="label">确认新密码</text>
    <input class="input" password value="{{confirm}}" bindinput="onConfirm" placeholder="再次输入新密码" />
  </view>
  <button class="save" loading="{{saving}}" bindtap="onSave">保存</button>
  <text class="tip">微信一键登录的账号若未设过密码,请先在网页端设置。</text>
</view>
