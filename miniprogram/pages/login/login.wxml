<view class="login">
  <view class="brand">
    <text class="logo">Scholay</text>
    <text class="tag">学术检索 · AI 助手</text>
  </view>

  <button class="btn primary big tap" hover-class="hover-scale" loading="{{loading}}" bindtap="onWxLogin">微信一键登录</button>

  <view class="divider"><text>或用账号登录</text></view>

  <view class="seg">
    <view class="seg-item {{mode==='password'?'on':''}}" data-mode="password" bindtap="switchMode">密码登录</view>
    <view class="seg-item {{mode==='code'?'on':''}}" data-mode="code" bindtap="switchMode">验证码登录</view>
  </view>

  <view class="form">
    <input class="field" type="text" placeholder="邮箱" value="{{email}}" bindinput="onEmail" />
    <input wx:if="{{mode==='password'}}" class="field" password placeholder="密码" value="{{password}}" bindinput="onPassword" />
    <view wx:else class="field-row">
      <input class="field flex1" type="number" maxlength="6" placeholder="6 位验证码" value="{{code}}" bindinput="onCode" />
      <view class="code-btn {{countdown>0?'disabled':''}}" bindtap="onSendCode">{{countdown>0 ? countdown+'s 后重发' : (sending ? '发送中' : '获取验证码')}}</view>
    </view>
    <button class="btn primary big tap" hover-class="hover-scale" loading="{{submitting}}" bindtap="onSubmit">登录</button>
  </view>

  <text class="policy">登录即表示同意《服务条款》与《隐私政策》</text>
</view>
