.search-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
  background: var(--card);
  border-bottom: 1rpx solid var(--border);
  padding: 16rpx 24rpx;
}
.search-box {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.search-input {
  flex: 1;
  height: 72rpx;
  background: var(--bg);
  border-radius: 36rpx;
  padding: 0 28rpx;
  font-size: var(--fs-body);
}
.search-go {
  color: var(--red);
  font-size: var(--fs-body);
  padding: 0 8rpx;
}
.search-body {
  padding: 180rpx 24rpx 60rpx;
}
.filter-bar {
  display: flex;
  margin-top: 12rpx;
}
.filter-btn {
  padding: 8rpx 26rpx;
  background: var(--bg);
  border-radius: 24rpx;
  font-size: 26rpx;
  color: var(--text-weak);
}
.fbadge {
  margin-left: 8rpx;
  background: var(--red);
  color: var(--on-brand);
  border-radius: 16rpx;
  padding: 0 10rpx;
  font-size: 22rpx;
}
.mask {
  position: fixed;
  inset: 0;
  z-index: 200;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}
.fsheet {
  background: var(--card);
  border-radius: 24rpx 24rpx 0 0;
  max-height: 82vh;
  display: flex;
  flex-direction: column;
}
.fsheet-body {
  max-height: 64vh;
  padding: 28rpx 28rpx 8rpx;
}
.fgroup {
  margin-bottom: 28rpx;
}
.fgroup.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.fglabel {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 14rpx;
}
.fgroup.row .fglabel {
  margin-bottom: 0;
}
.fchips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
.fchip {
  padding: 10rpx 26rpx;
  background: var(--bg);
  border-radius: 28rpx;
  font-size: 26rpx;
  color: var(--text-weak);
}
.fchip.on {
  background: var(--red);
  color: var(--on-brand);
}
.fnote {
  color: var(--text-weak);
  font-size: 26rpx;
  padding: 20rpx 0;
}
.fsheet-foot {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--border);
}
.freset {
  padding: 0 32rpx;
  line-height: 80rpx;
  color: var(--text-weak);
  font-size: var(--fs-body);
}
.fapply {
  flex: 1;
  background: var(--red);
  color: var(--on-brand);
  border-radius: 16rpx;
  font-size: var(--fs-body);
  line-height: 80rpx;
}
.state {
  padding: 140rpx 0;
  text-align: center;
  color: var(--text-weak);
  font-size: 28rpx;
}
.state.error {
  color: var(--red);
}
.row {
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--border);
}
.row-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.row-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--text-weak);
}
.row-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}
.row-cite {
  font-size: 24rpx;
  color: var(--text-weak);
}
.badge {
  font-size: 22rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  background: var(--bg);
  color: var(--text-weak);
}
.badge.oa {
  background: var(--green-soft);
  color: var(--green);
}
.jrow {
  display: flex;
  gap: 20rpx;
}
.cover {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  color: var(--on-brand);
  font-size: 36rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.jmain {
  flex: 1;
  min-width: 0;
}
.more {
  text-align: center;
  color: var(--text-weak);
  font-size: 26rpx;
  padding: 32rpx 0;
}
