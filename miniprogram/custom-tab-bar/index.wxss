.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  height: calc(100rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: #ffffff;
  border-top: 1rpx solid #e5e5ea;
}
.tab {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  transition: transform 0.1s;
}
.tab:active {
  transform: scale(0.92);
}
/* 忠实照设计:无彩色指示条,激活靠 前景黑+加粗 与 faint 灰区分。 */
.indicator {
  display: none;
}
.icon {
  width: 44rpx;
  height: 44rpx;
}
.label {
  font-size: 22rpx;
  line-height: 1;
  color: var(--text-faint);
}
.tab.on .label {
  font-weight: 600;
  color: var(--text);
}
